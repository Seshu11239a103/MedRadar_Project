async function loadPriceComparison(medId) {
  currentCompareMed = parseInt(medId);
  let data = await api(`/api/price_comparison?med_id=${currentCompareMed}`);
  if (!data) data = localPriceComparison(currentCompareMed);

  const m = data.medicine;
  const g = data.jan_aushadhi_generic;

  // Hero Comparison
  $('#compare-hero-wrap').innerHTML = `
    <div class="compare-hero">
      <div class="brand-hero-card">
        <span class="pill" style="background:#475569;">Branded Formulation</span>
        <h2 style="margin:10px 0 2px; font-size:1.6rem; color:var(--ink);">${m.brand}</h2>
        <div style="color:var(--mut); font-size:0.88rem;">${m.salt} · ${m.strength}</div>
        <div style="font-size:2rem; font-weight:800; color:var(--ink); margin:14px 0 4px;">
          ₹${m.price} <span style="font-size:0.95rem; font-weight:normal; color:var(--mut); text-decoration:line-through;">MRP ₹${data.jan_aushadhi_generic.mrp}</span>
        </div>
        <div style="font-size:0.8rem; color:var(--mut);">${m.packaging || 'Standard Packaging'}</div>
      </div>

      <div class="generic-hero-card">
        <div class="savings-tag">SAVE ${g.savings_pct}%</div>
        <span class="pill" style="background:var(--ok);">PMBJP Jan Aushadhi Generic</span>
        <h2 style="margin:10px 0 2px; font-size:1.6rem; color:#fff;">${g.generic_name}</h2>
        <div style="color:#d1fae5; font-size:0.88rem;">Exact Active Salt: ${g.salt} ${g.strength}</div>
        <div style="font-size:2.2rem; font-weight:800; color:#34d399; margin:14px 0 4px;">
          ₹${g.price} <span style="font-size:0.95rem; font-weight:normal; color:#a7f3d0;">/ pack</span>
        </div>
        <div style="font-size:0.8rem; color:#d1fae5;">
          📍 Available at: <b>${g.kendra_name}</b> (${g.kendra_address})
        </div>
        <div style="font-size:0.75rem; color:#6ee7b7; margin-top:8px;">
          🛡️ ${g.bioequivalence_rating}
        </div>
      </div>
    </div>
  `;

  // Chronic Calculator & Savings Donut
  const savingsPct = g.savings_pct || Math.round((1 - g.price / m.price) * 100);
  const costPct = 100 - savingsPct;
  const priceDonutData = [
    { label: "Generic Savings", pct: savingsPct, color: "#10b981" },
    { label: "Generic Cost", pct: costPct, color: "#8b5cf6" }
  ];

  $('#chronic-calc-wrap').innerHTML = `
    <div style="background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:20px;">
      <h3 style="margin-top:0;">Chronic Patient Monthly Savings Calculator</h3>
      <p style="color:var(--mut); font-size:0.85rem;">For long-term prescriptions (BP, Diabetes, Thyroid, Cardiac): calculate annual out-of-pocket savings.</p>

      <div style="display:grid; grid-template-columns: 1.2fr 0.8fr 1fr; gap:16px; align-items:center; margin-top:16px;">
        <div>
          <label style="margin:0 0 6px;">Monthly Packs / Strips Needed:</label>
          <input type="range" id="calc-qty-slider" min="1" max="6" value="2" oninput="updateChronicCalc(${m.price}, ${g.price})" style="width:100%; accent-color:var(--ok);">
          <div style="display:flex; justify-content:space-between; font-size:0.8rem; color:var(--mut); margin-top:4px;">
            <span>1 pack</span><span>2 packs (typical)</span><span>4 packs</span><span>6 packs</span>
          </div>
        </div>
        <div style="background:rgba(16, 185, 129, 0.12); border:1px solid var(--ok); border-radius:14px; padding:14px; text-align:center;">
          <span style="font-size:0.75rem; color:var(--mut); text-transform:uppercase; font-weight:700;">Annual Money Saved</span>
          <div id="calc-annual-saved" style="font-size:1.8rem; font-weight:800; color:var(--ok);">₹${(m.price - g.price) * 2 * 12}</div>
          <span style="font-size:0.72rem; color:var(--mut);">Saved every year by switching to Jan Aushadhi</span>
        </div>
        <div id="price-savings-donut-wrap" style="display:flex; justify-content:center; align-items:center;"></div>
      </div>
    </div>
  `;

  $('#price-savings-donut-wrap').innerHTML = createSvgPieChart(priceDonutData, {
    size: 160,
    donut: true,
    centerLabel: `${savingsPct}%`,
    centerSub: 'Saved'
