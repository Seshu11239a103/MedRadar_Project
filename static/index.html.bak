<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0ea5e9">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="MedRadar">
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/svg+xml" href="icon.svg">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<title>MedRadar — Smart Medicine Availability, Shortage Forecasting & Emergency Radar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0b1319;
  --panel: #131e27;
  --card: #1a2834;
  --card-hover: #223444;
  --ink: #f0f6fc;
  --mut: #8b9eb0;
  --line: #273949;
  --cob: #3b82f6;
  --cob-glow: rgba(59, 130, 246, 0.25);
  --ok: #10b981;
  --ok-bg: rgba(16, 185, 129, 0.12);
  --warn: #f59e0b;
  --warn-bg: rgba(245, 158, 11, 0.12);
  --bad: #ef4444;
  --bad-bg: rgba(239, 68, 68, 0.12);
  --em: #ec4899;
  --em-red: #f43f5e;
  --em-glow: rgba(244, 63, 94, 0.35);
  --purp: #8b5cf6;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

header {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
  padding: 14px 24px;
  background: rgba(19, 30, 39, 0.92);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
  position: sticky;
  top: 0;
  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 800;
  font-size: 1.35rem;
  letter-spacing: -0.03em;
  cursor: pointer;
}
.brand-icon {
  width: 32px;
  height: 32px;
  background: radial-gradient(circle, var(--cob) 0%, #1d4ed8 100%);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 15px var(--cob-glow);
}
.brand b { color: var(--cob); }

nav {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  align-items: center;
}
nav button {
  background: transparent;
  border: 1px solid transparent;
  padding: 7px 14px;
  border-radius: 99px;
  font-family: inherit;
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--mut);
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  white-space: nowrap;
}
nav button:hover { color: var(--ink); background: rgba(255,255,255,0.06); }
nav button[aria-selected=true] {
  background: var(--cob);
  color: #fff;
  border-color: var(--cob);
  box-shadow: 0 0 12px var(--cob-glow);
}
nav button.tab-emergency {
  border-color: rgba(244, 63, 94, 0.4);
  color: #fb7185;
}
nav button.tab-emergency[aria-selected=true] {
  background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
  color: #fff;
  border-color: #f43f5e;
  box-shadow: 0 0 16px var(--em-glow);
}

.header-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
.btn-quick-sos {
  background: linear-gradient(135deg, #e11d48 0%, #9f1239 100%);
  border: 1px solid #f43f5e;
  color: #fff;
  padding: 6px 14px;
  border-radius: 99px;
  font-weight: 800;
  font-size: 0.82rem;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 0 15px var(--em-glow);
  animation: pulseSos 2.5s infinite;
  white-space: nowrap;
}
@keyframes pulseSos {
  0% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.6); }
  70% { box-shadow: 0 0 0 10px rgba(244, 63, 94, 0); }
  100% { box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
}
.btn-lang {
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--line);
  color: var(--ink);
  padding: 6px 12px;
  border-radius: 99px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-lang:hover { background: rgba(255,255,255,0.12); }

.top-bar {
  background: rgba(59, 130, 246, 0.08);
  border-bottom: 1px solid rgba(59, 130, 246, 0.2);
  padding: 8px 24px;
  font-size: 0.83rem;
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
}
.live-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--ok);
  font-weight: 600;
}
.pulse-dot {
  width: 8px;
  height: 8px;
  background: var(--ok);
  border-radius: 50%;
  box-shadow: 0 0 8px var(--ok);
  animation: pulse 2s infinite;
}
.pulse-dot-sm {
  width: 6px;
  height: 6px;
  background: var(--ok);
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 0 6px var(--ok);
}
@keyframes pulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
  70% { transform: scale(1); box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

main { max-width: 1300px; margin: auto; padding: 24px 20px; }
h1 { font-size: clamp(1.5rem, 3.2vw, 2.1rem); letter-spacing: -0.03em; margin: 0 0 6px; font-weight: 800; }
.lede { color: var(--mut); margin-bottom: 20px; font-size: 0.95rem; }

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
}
@media(max-width: 960px) { .grid { grid-template-columns: 1fr; } }

.control-panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 22px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

label {
  display: block;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--mut);
  margin: 16px 0 6px;
}

select, input[type="text"], input[type="number"], input[type="tel"], input[type="email"] {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--card);
  color: var(--ink);
  font-family: inherit;
  font-size: 0.93rem;
  transition: border-color 0.2s;
}
select:focus, input:focus {
  outline: none;
  border-color: var(--cob);
  box-shadow: 0 0 0 3px var(--cob-glow);
}

.cat-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}
.chip {
  padding: 5px 12px;
  border-radius: 99px;
  font-size: 0.78rem;
  font-weight: 600;
  background: var(--card);
  border: 1px solid var(--line);
  color: var(--mut);
  cursor: pointer;
  transition: all 0.2s;
}
.chip:hover, .chip.active {
  background: var(--cob);
  color: #fff;
  border-color: var(--cob);
}
.chip.em-chip {
  border-color: rgba(236, 72, 153, 0.4);
  color: #f472b6;
}
.chip.em-chip.active {
  background: var(--em);
  color: #fff;
}

.loc-row {
  display: flex;
  gap: 10px;
}
.btn-gps {
  white-space: nowrap;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid var(--ok);
  color: var(--ok);
  padding: 0 16px;
  border-radius: 12px;
  font-weight: 700;
  font-size: 0.86rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s;
}
.btn-gps:hover { background: var(--ok); color: #fff; }

button.go {
  margin-top: 20px;
  width: 100%;
  padding: 14px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--cob) 0%, #2563eb 100%);
  color: #fff;
  font-family: inherit;
  font-weight: 700;
  font-size: 1.05rem;
  cursor: pointer;
  box-shadow: 0 4px 20px var(--cob-glow);
  transition: transform 0.1s, box-shadow 0.2s;
}
button.go:active { transform: scale(0.99); }

.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 14px 16px;
  margin: 12px 0;
  transition: all 0.2s;
  border-left: 6px solid var(--line);
  position: relative;
}
.card:hover { background: var(--card-hover); }
.card.in_stock { border-left-color: var(--ok); }
.card.call_ahead { border-left-color: var(--warn); }
.card.likely_out { border-left-color: var(--bad); }
.card.sel { outline: 2px solid var(--cob); background: var(--card-hover); }

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}
.card h3 { margin: 0 0 4px; font-size: 1.05rem; font-weight: 700; }
.card-meta { color: var(--mut); font-size: 0.84rem; }
.pill {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 99px;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  white-space: nowrap;
}
.in_stock .pill { background: var(--ok); }
.call_ahead .pill { background: var(--warn); }
.likely_out .pill { background: var(--bad); }

.stock-verified-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: rgba(16, 185, 129, 0.12);
  border: 1px solid rgba(16, 185, 129, 0.35);
  color: #34d399;
  font-size: 0.76rem;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s;
}
.stock-verified-badge:hover {
  background: rgba(16, 185, 129, 0.22);
  border-color: var(--ok);
}
.badge-24x7 {
  background: rgba(244, 63, 94, 0.15);
  border: 1px solid rgba(244, 63, 94, 0.4);
  color: #fb7185;
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 6px;
}

.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--line);
}
.btn-action {
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--line);
  color: var(--ink);
  padding: 6px 11px;
  border-radius: 8px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all 0.2s;
}
.btn-action:hover { background: rgba(255,255,255,0.12); }
.btn-wa { background: rgba(37, 211, 102, 0.15); border-color: rgba(37, 211, 102, 0.4); color: #25d366; }
.btn-wa:hover { background: #25d366; color: #fff; }
.btn-call { background: rgba(59, 130, 246, 0.15); border-color: rgba(59, 130, 246, 0.4); color: var(--cob); }
.btn-call:hover { background: var(--cob); color: #fff; }
.btn-map { background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.4); color: var(--warn); }
.btn-map:hover { background: var(--warn); color: #fff; }
.btn-delivery {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.22) 0%, rgba(5, 150, 105, 0.28) 100%);
  border: 1px solid rgba(16, 185, 129, 0.55);
  color: #34d399;
  font-weight: 700;
}
.btn-delivery:hover {
  background: var(--ok);
  color: #fff;
  border-color: var(--ok);
  box-shadow: 0 0 16px rgba(16, 185, 129, 0.4);
}
.btn-verify {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(59, 130, 246, 0.4);
  color: #60a5fa;
  font-weight: 700;
}
.btn-verify:hover { background: var(--cob); color: #fff; }
.btn-compare {
  background: rgba(139, 92, 246, 0.15);
  border-color: rgba(139, 92, 246, 0.4);
  color: #c084fc;
  font-weight: 700;
}
.btn-compare:hover { background: #8b5cf6; color: #fff; }

.banner {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 20px;
}
.radar-box {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 480px;
  position: relative;
}
.radar-svg { width: 100%; max-width: 580px; height: auto; display: block; }

/* MODALS */
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5, 10, 15, 0.82);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 16px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
}
.modal-backdrop.active {
  opacity: 1;
  pointer-events: auto;
}
.modal-box {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  max-width: 580px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0,0,0,0.6);
  animation: modalSlide 0.24s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes modalSlide {
  from { transform: translateY(16px) scale(0.97); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 22px;
  border-bottom: 1px solid var(--line);
}
.modal-body { padding: 20px 22px; }
.btn-modal-close {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--line);
  color: var(--mut);
  width: 32px;
  height: 32px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.95rem;
  transition: all 0.2s;
}
.btn-modal-close:hover { background: var(--bad); color: #fff; border-color: var(--bad); }

/* UPI & INVOICE MODALS */
.upi-modal-box {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  max-width: 440px;
  width: 100%;
  padding: 24px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0,0,0,0.6);
}
.upi-qr-frame {
  background: #fff;
  padding: 12px;
  border-radius: 14px;
  display: inline-block;
  margin: 12px auto;
  box-shadow: 0 4px 20px rgba(0,0,0,0.25);
}
.upi-badge-row {
  display: flex;
  justify-content: center;
  gap: 6px;
  flex-wrap: wrap;
}
.upi-pill {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 3px 8px;
  background: rgba(255,255,255,0.06);
  border: 1px solid var(--line);
  border-radius: 99px;
  color: var(--mut);
}

.invoice-modal-box {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  max-width: 740px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 20px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.6);
}
.invoice-paper {
  background: #ffffff;
  color: #0f172a;
  border-radius: 12px;
  padding: 24px;
  font-family: system-ui, -apple-system, sans-serif;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
}
.inv-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border-bottom: 2px solid #0f172a;
  padding-bottom: 12px;
  margin-bottom: 12px;
}
.inv-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8rem;
  margin: 12px 0;
}
.inv-table th {
  background: #f1f5f9;
  color: #334155;
  padding: 8px;
  border: 1px solid #cbd5e1;
  text-align: left;
}
.inv-table td {
  padding: 8px;
  border: 1px solid #e2e8f0;
}
@media print {
  body * { visibility: hidden; }
  #invoice-modal, #invoice-modal * { visibility: visible; }
  #invoice-modal { position: absolute; left: 0; top: 0; width: 100%; background: #fff; }
  .no-print { display: none !important; }
}

/* Rx Upload Dropzone */
.rx-dropzone {
  border: 1.5px dashed var(--line);
  border-radius: 12px;
  background: var(--card);
  cursor: pointer;
  transition: all 0.2s;
  padding: 14px;
  text-align: center;
  margin-top: 8px;
}
.rx-dropzone:hover {
  border-color: var(--cob);
  background: var(--card-hover);
}

/* TOAST NOTIFICATION */
.toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
}
.toast-banner {
  pointer-events: auto;
  background: #1e293b;
  border: 1px solid var(--cob);
  box-shadow: 0 10px 35px rgba(0,0,0,0.5);
  border-radius: 14px;
  padding: 14px 18px;
  max-width: 380px;
  color: #fff;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  animation: toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transition: all 0.3s ease;
}
.toast-banner.toast-success { border-color: var(--ok); background: #064e3b; }
.toast-banner.toast-emergency { border-color: var(--em-red); background: #881337; }
@keyframes toastIn {
  from { transform: translateX(40px); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* EMERGENCY VIEW STYLES */
.emergency-banner {
  background: linear-gradient(135deg, rgba(225, 29, 72, 0.2) 0%, rgba(159, 18, 57, 0.35) 100%);
  border: 1px solid rgba(244, 63, 94, 0.45);
  border-radius: 18px;
  padding: 20px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  box-shadow: 0 10px 30px var(--em-glow);
}
.em-beacon-icon { font-size: 2.2rem; line-height: 1; }
.btn-em-gps {
  background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
  border: none;
  color: #fff;
  padding: 12px 20px;
  border-radius: 12px;
  font-weight: 800;
  font-size: 0.95rem;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(244, 63, 94, 0.45);
  transition: transform 0.15s;
}
.btn-em-gps:hover { transform: scale(1.02); }
.emergency-chips-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.em-chip {
  padding: 8px 14px;
  border-radius: 99px;
  font-size: 0.82rem;
  font-weight: 700;
  background: var(--card);
  border: 1px solid rgba(244, 63, 94, 0.3);
  color: #fca5a5;
  cursor: pointer;
  transition: all 0.2s;
}
.em-chip:hover, .em-chip.active {
  background: #e11d48;
  color: #fff;
  border-color: #f43f5e;
  box-shadow: 0 0 12px rgba(244, 63, 94, 0.4);
}
.emergency-card {
  background: var(--card);
  border: 1px solid rgba(244, 63, 94, 0.35);
  border-left: 6px solid #e11d48;
  border-radius: 14px;
  padding: 16px 18px;
  margin-bottom: 14px;
}
.em-helpline-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
}

/* HEATMAP STYLES */
.heatmap-kpi-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}
.kpi-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 16px;
}
.kpi-card b { display: block; font-size: 1.6rem; letter-spacing: -0.02em; margin-top: 4px; }
.heatmap-svg-wrap {
  width: 100%;
  background: #080e14;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 14px;
  overflow: hidden;
}
.heat-legend-inline {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.heat-legend-pill {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 4px;
}
.heat-crit { background: rgba(239, 68, 68, 0.25); color: #f87171; border: 1px solid #ef4444; }
.heat-elev { background: rgba(249, 115, 22, 0.25); color: #fb923c; border: 1px solid #f97316; }
.heat-mod { background: rgba(234, 179, 8, 0.25); color: #fde047; border: 1px solid #eab308; }
.heat-low { background: rgba(16, 185, 129, 0.25); color: #34d399; border: 1px solid #10b981; }

/* FORECAST STYLES */
.forecast-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}

/* PRICE COMPARISON STYLES */
.compare-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 24px;
}
@media(max-width: 768px) { .compare-hero { grid-template-columns: 1fr; } }
.brand-hero-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 20px;
}
.generic-hero-card {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(5, 150, 105, 0.18) 100%);
  border: 2px solid var(--ok);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 0 25px rgba(16, 185, 129, 0.18);
  position: relative;
}
.savings-tag {
  position: absolute;
  top: 14px;
  right: 14px;
  background: var(--ok);
  color: #fff;
  font-weight: 800;
  padding: 4px 10px;
  border-radius: 99px;
  font-size: 0.8rem;
}

/* RESTOCK ALERTS STYLES */
.alert-card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 12px;
}
.btn-simulate-restock {
  background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
  border: 1px solid #a78bfa;
  color: #fff;
  font-weight: 700;
}
.btn-simulate-restock:hover {
  box-shadow: 0 0 16px rgba(139, 92, 246, 0.45);
}

/* FLOATING KIT BAR */
#kit-bar {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: rgba(19, 30, 39, 0.95);
  backdrop-filter: blur(16px);
  border: 1.5px solid var(--cob);
  box-shadow: 0 12px 40px rgba(0,0,0,0.6);
  border-radius: 99px;
  padding: 10px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  z-index: 900;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
#kit-bar.active { transform: translateX(-50%) translateY(0); }
.btn-checkout-kit {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border: 0;
  color: #fff;
  font-weight: 800;
  font-size: 0.9rem;
  padding: 8px 18px;
  border-radius: 99px;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
}

footer {
  text-align: center;
  padding: 30px 20px;
  color: var(--mut);
  font-size: 0.85rem;
  border-top: 1px solid var(--line);
  margin-top: 40px;
}
.pod-option-card {
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  user-select: none;
}
.pod-option-card:hover {
  border-color: var(--cob) !important;
  background: rgba(14, 165, 233, 0.06) !important;
}
.pod-option-card.active {
  border-color: var(--ok) !important;
  background: rgba(16, 185, 129, 0.1) !important;
  box-shadow: 0 0 0 1px var(--ok);
}
</style>
</head>
<body>

<header>
  <div class="brand" onclick="switchTab('find')">
    <div class="brand-icon">📡</div>
    <div>Med<b>Radar</b></div>
  </div>
  <nav role="tablist">
    <button role="tab" aria-selected="true" data-v="find">🔍 Find & Verify</button>
    <button role="tab" aria-selected="false" data-v="emergency" class="tab-emergency">🚨 Emergency SOS</button>
    <button role="tab" aria-selected="false" data-v="heatmap">🗺️ Shortage Heatmap</button>
    <button role="tab" aria-selected="false" data-v="forecast">📈 Shortage Forecast</button>
    <button role="tab" aria-selected="false" data-v="compare">💰 Price Compare</button>
    <button role="tab" aria-selected="false" data-v="alerts">🔔 Restock Alerts <span id="alerts-badge" class="pill" style="background:var(--ok); font-size:0.68rem; margin-left:3px;">3</span></button>
    <button role="tab" aria-selected="false" data-v="orders">🛵 Delivery Orders <span id="orders-badge" class="pill" style="background:var(--ok); font-size:0.68rem; margin-left:3px; display:none;">0</span></button>
    <button role="tab" aria-selected="false" data-v="stock">📦 Restock Desk</button>
    <button role="tab" aria-selected="false" data-v="model">📊 AI Model</button>
  </nav>
  <div class="header-right">
    <button id="btn-pwa-install" class="chip" style="display:inline-flex; align-items:center; gap:5px; background:linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color:#fff; border:0; font-weight:700; padding:6px 12px; font-size:0.76rem; cursor:pointer;" onclick="triggerPwaInstall()">📲 Install App</button>
    <button class="btn-quick-sos" onclick="switchTab('emergency')">🚨 SOS FINDER</button>
    <button id="btn-lang" class="btn-lang" onclick="toggleLanguage()" title="Switch Language">🌐 தமிழ்</button>
  </div>
</header>

<div id="pwa-install-banner" style="display:none; align-items:center; justify-content:space-between; background:linear-gradient(90deg, rgba(14,165,233,0.18) 0%, rgba(16,185,129,0.18) 100%); border:1px solid rgba(14,165,233,0.4); border-radius:12px; padding:10px 18px; margin:12px 24px 0; gap:12px; flex-wrap:wrap;">
  <div style="display:flex; align-items:center; gap:12px;">
    <div style="font-size:1.8rem; background:rgba(0,0,0,0.25); border-radius:10px; width:44px; height:44px; display:flex; align-items:center; justify-content:center;">📲</div>
    <div>
      <b style="font-size:0.94rem; color:var(--ink);">Install MedRadar App on your Phone or Laptop</b>
      <div style="font-size:0.78rem; color:var(--mut);">1-click instant install · Fullscreen app view · Fast offline-ready medical radar</div>
    </div>
  </div>
  <div style="display:flex; align-items:center; gap:8px;">
    <button class="btn-action" style="background:linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color:#fff; border:0; font-weight:800; padding:7px 16px; font-size:0.82rem;" onclick="triggerPwaInstall()">Install App</button>
    <button class="chip" style="padding:4px 8px; font-size:0.75rem;" onclick="dismissPwaBanner()">✕</button>
  </div>
</div>

<div class="top-bar">
  <div class="live-badge">
    <span class="pulse-dot"></span>
    Live Network Sync: Kanchipuram & Extended Region (18 Active Pharmacies · Cloud POS Connected)
  </div>
  <div style="color: var(--mut);">
    Real-time stock verification · Multi-day shortage forecasting · Jan Aushadhi generic savings
  </div>
</div>

<main>
  <!-- ========================================== -->
  <!-- VIEW 1: FIND MEDICINE & VERIFY STOCK       -->
  <!-- ========================================== -->
  <section id="v-find">
    <div class="grid">
      <div class="control-panel">
        <h1>Is your medicine in stock before you travel?</h1>
        <p class="lede">MedRadar ranks pharmacies by verified stock probability, expected trip cost, and real-time POS audits.</p>

        <!-- Category Filter Checkbox Buttons -->
        <label>Filter by Therapeutic Category</label>
        <div class="cat-chips" id="cat-chips">
          <button type="button" class="chip active" data-cat="all">✓ All Medicines</button>
          <button type="button" class="chip em-chip" data-cat="em">🚨 Emergency</button>
          <button type="button" class="chip" data-cat="Fever & pain">Fever & Pain</button>
          <button type="button" class="chip" data-cat="Diabetes">Diabetes</button>
          <button type="button" class="chip" data-cat="Heart & BP">Heart & BP</button>
          <button type="button" class="chip" data-cat="Breathing">Breathing</button>
          <button type="button" class="chip" data-cat="Antibiotics">Antibiotics</button>
          <button type="button" class="chip" data-cat="Stomach">Stomach</button>
          <button type="button" class="chip" data-cat="Cold & allergy">Cold & Allergy</button>
          <button type="button" class="chip" data-cat="Thyroid">Thyroid</button>
          <button type="button" class="chip" data-cat="Vitamins">Vitamins</button>
        </div>

        <!-- Medicine Select Dropdown -->
        <label for="med-select">Select Medicine</label>
        <select id="med-select"></select>
        <div id="med-detail-badge" style="margin-top:6px; font-size:0.8rem; color:var(--mut);"></div>

        <!-- Location Selection & GPS -->
        <label for="area">Your Location (Kanchipuram & Region)</label>
        <div class="loc-row">
          <select id="area" style="flex:1;"></select>
          <button type="button" class="btn-gps" id="btn-gps">📍 Live GPS</button>
        </div>
        <div id="gps-status" style="font-size:0.75rem; color:var(--mut); margin-top:4px;"></div>

        <!-- Search Radius Slider -->
        <label for="rad">Search Radius: <b id="ro" style="color:var(--cob);">15</b> km</label>
        <input type="range" id="rad" min="2" max="45" value="15" style="width:100%; accent-color:var(--cob);">

        <!-- Checkbox Options Panel -->
        <div style="margin-top:14px; background:rgba(255,255,255,0.03); border:1px solid var(--line); border-radius:12px; padding:12px; display:flex; flex-direction:column; gap:8px;">
          <div style="font-size:0.75rem; color:var(--mut); font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">Visualization & Search Options</div>
          <label style="margin:0; display:flex; align-items:center; gap:8px; text-transform:none; cursor:pointer; font-size:0.86rem; color:var(--ink);">
            <input type="checkbox" id="chk-display-pie" checked style="width:18px; height:18px; accent-color:var(--cob); cursor:pointer;" onchange="handleVisCheckboxToggle()">
            <span>🥧 <b>Display Availability Pie Chart</b> (Stock share breakdown)</span>
          </label>
          <label style="margin:0; display:flex; align-items:center; gap:8px; text-transform:none; cursor:pointer; font-size:0.86rem; color:var(--ink);">
            <input type="checkbox" id="chk-display-radar" checked style="width:18px; height:18px; accent-color:var(--cob); cursor:pointer;" onchange="handleVisCheckboxToggle()">
            <span>📡 <b>Display Radar Geographic Map</b> (Range circles & ETA)</span>
          </label>
          <label style="margin:0; display:flex; align-items:center; gap:8px; text-transform:none; cursor:pointer; font-size:0.86rem; color:var(--ink);">
            <input type="checkbox" id="subs" checked style="width:18px; height:18px; accent-color:var(--cob); cursor:pointer;">
            <span>🔄 <b>Include same-salt chemical substitutes & generic options</b></span>
          </label>
        </div>

        <button type="button" class="go" id="go">🔍 Find Best Stocked Pharmacies</button>

        <!-- Quick Access Feature Pills -->
        <div style="margin-top:18px; padding-top:14px; border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:8px;">
          <button type="button" class="chip" onclick="switchTab('emergency')">🚨 Emergency SOS Mode</button>
          <button type="button" class="chip" onclick="switchTab('compare')">💰 Price & Generic Savings</button>
          <button type="button" class="chip" onclick="switchTab('heatmap')">🗺️ Shortage Heatmap</button>
          <button type="button" class="chip" onclick="switchTab('forecast')">📈 Shortage Forecast</button>
        </div>
      </div>

      <div>
        <div id="sum"></div>

        <!-- Visualizer Mode Buttons -->
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:8px;">
          <div style="font-size:0.88rem; font-weight:700; color:var(--ink);">Visual Stock Intelligence</div>
          <div class="vis-view-tabs" style="display:flex; gap:6px;">
            <button type="button" class="chip active" id="btn-view-pie" onclick="setVisualizerView('pie')">🥧 Pie Chart View</button>
            <button type="button" class="chip" id="btn-view-radar" onclick="setVisualizerView('radar')">📡 Radar View</button>
            <button type="button" class="chip" id="btn-view-both" onclick="setVisualizerView('both')">📊 Split (Both)</button>
          </div>
        </div>

        <!-- Prominent Availability Pie Chart Container -->
        <div id="find-pie-panel" style="background:var(--card); border:1px solid var(--line); border-radius:18px; padding:20px; margin-bottom:14px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <h3 style="margin:0; font-size:1.1rem; color:var(--ink); display:flex; align-items:center; gap:8px;">
              <span>🥧 Search Radius Availability Breakdown</span>
            </h3>
            <span class="pill" id="find-pie-total-pill" style="background:var(--cob);">18 Pharmacies</span>
          </div>
          <div id="find-pie-svg-wrap" style="display:flex; justify-content:center; align-items:center; min-height:220px;"></div>
        </div>

        <!-- Radar Box Container -->
        <div class="radar-box" id="radar-box-panel" style="display:none;">
          <svg class="radar-svg" id="svg" viewBox="0 0 640 640"></svg>
        </div>
      </div>
    </div>

    <!-- Results List & Substitutes -->
    <div style="margin-top:24px;">
      <h2 style="font-size:1.3rem; margin-bottom:12px;">Nearby Pharmacies Ranked by Expected Availability</h2>
      <div id="res"></div>
      <div id="sb"></div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 2: EMERGENCY MEDICINE FINDER          -->
  <!-- ========================================== -->
  <section id="v-emergency" hidden>
    <div class="emergency-banner">
      <div style="display:flex; align-items:center; gap:14px;">
        <span class="em-beacon-icon">🚨</span>
        <div>
          <h1 style="margin:0 0 4px; font-size:1.6rem; color:#fff;">Emergency Medicine SOS Finder</h1>
          <p style="margin:0; font-size:0.9rem; color:#fecdd3;">Instant 24x7 life-saving medicine locator with live verified shelf stock and zero-delay priority dispatch.</p>
        </div>
      </div>
      <button type="button" class="btn-em-gps" onclick="findEmergencyGps()">📍 Locate Nearest Emergency Stock (GPS)</button>
    </div>

    <label style="margin-top:20px;">Emergency Triage Quick Filter:</label>
    <div class="emergency-chips-grid" id="em-chips">
      <button class="em-chip active" data-em="all" onclick="filterEmergencyCategory('all')">🚨 All Life-Saving Medicines</button>
      <button class="em-chip" data-em="cardiac" onclick="filterEmergencyCategory('cardiac')">🫀 Chest Pain / Angina (Sorbitrate / Aspirin)</button>
      <button class="em-chip" data-em="asthma" onclick="filterEmergencyCategory('asthma')">🫁 Asthma Attack (Asthalin / Foracort)</button>
      <button class="em-chip" data-em="diabetic" onclick="filterEmergencyCategory('diabetic')">🩸 Diabetic Crisis (Lantus / Mixtard)</button>
      <button class="em-chip" data-em="pain" onclick="filterEmergencyCategory('pain')">⚡ Severe Spasmodic Colic (Meftal-Spas)</button>
      <button class="em-chip" data-em="ors" onclick="filterEmergencyCategory('ors')">💧 Acute Dehydration (Electral ORS)</button>
    </div>

    <div class="grid" style="margin-top:22px; grid-template-columns: 1.3fr 0.9fr;">
      <div>
        <h2 style="font-size:1.25rem; margin-bottom:12px;">Fastest Emergency Response Pharmacies</h2>
        <div id="em-pharmacy-list"></div>
      </div>

      <div>
        <div class="control-panel" style="border-color: rgba(244, 63, 94, 0.4);">
          <h3 style="margin-top:0; color:#fb7185; display:flex; align-items:center; gap:8px;">
            <span>🚑 24x7 Emergency Helplines & Trauma Desks</span>
          </h3>
          <p style="color:var(--mut); font-size:0.85rem; margin-bottom:14px;">Instant 1-tap call to government ambulance, casualty wards, and poison control.</p>

          <div id="em-helplines-wrap"></div>

          <div style="background:rgba(244, 63, 94, 0.08); border:1px solid rgba(244, 63, 94, 0.25); border-radius:12px; padding:14px; margin-top:16px;">
            <b style="color:#fb7185; font-size:0.85rem; display:block; margin-bottom:4px;">🛡️ Emergency Medicine Protocol:</b>
            <div style="font-size:0.78rem; color:var(--mut); line-height:1.45;">
              For acute chest pain, administer Sorbitrate under tongue immediately. For acute asthma wheeze, 2 puffs of Asthalin inhaler. Kanchi District HQ Hospital casualty is operational 24 hours on Gandhi Road.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 3: MEDICINE SHORTAGE HEATMAP          -->
  <!-- ========================================== -->
  <section id="v-heatmap" hidden>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:18px;">
      <div>
        <h1 style="margin:0 0 4px;">🗺️ Medicine Shortage Spatial Heatmap</h1>
        <p class="lede" style="margin:0;">Geographic shortage intensity across Kanchipuram district and regional supply corridors.</p>
      </div>
      <div style="display:flex; align-items:center; gap:8px;">
        <label style="margin:0; font-size:0.82rem;">Filter Map By:</label>
        <select id="heatmap-med-filter" onchange="renderHeatmapPage()" style="width:auto; min-width:240px;"></select>
      </div>
    </div>

    <!-- Heatmap KPI Bar -->
    <div class="heatmap-kpi-bar" id="heatmap-kpi-bar"></div>

    <div class="grid" style="grid-template-columns: 1.35fr 0.95fr;">
      <div class="control-panel">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
          <span style="font-weight:700; font-size:0.95rem; color:var(--ink);">Kanchipuram & Extended Region Spatial Heat</span>
          <div class="heat-legend-inline">
            <span class="heat-legend-pill heat-crit">Critical (&gt;35%)</span>
            <span class="heat-legend-pill heat-elev">Elevated (22-35%)</span>
            <span class="heat-legend-pill heat-mod">Moderate (12-22%)</span>
            <span class="heat-legend-pill heat-low">Normal (&lt;12%)</span>
          </div>
        </div>
        <div class="heatmap-svg-wrap" id="heatmap-svg-wrap">
          <svg id="heatmap-svg" viewBox="0 0 760 520" style="width:100%; height:auto; display:block;"></svg>
        </div>
        <div style="font-size:0.78rem; color:var(--mut); margin-top:10px;">
          💡 <b>Interactive Map:</b> Click any glowing area hotspot to inspect local pharmacies and depleted medicines.
        </div>
      </div>

      <div>
        <div class="control-panel" id="zone-inspector-panel">
          <h3 style="margin-top:0;">Zone Inspector</h3>
          <p style="color:var(--mut); font-size:0.85rem;">Select any zone on the map to inspect live pharmacy stock and inventory gaps.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 4: MEDICINE SHORTAGE FORECASTING      -->
  <!-- ========================================== -->
  <section id="v-forecast" hidden>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:18px;">
      <div>
        <h1 style="margin:0 0 4px;">📈 Medicine Shortage Forecasting</h1>
        <p class="lede" style="margin:0;">Multi-day predictive depletion modeling, supplier delay risk, and demand stress simulation.</p>
      </div>
      <div style="display:flex; align-items:center; gap:8px;">
        <label style="margin:0; font-size:0.82rem;">Select Medicine:</label>
        <select id="forecast-med-select" onchange="loadMedicineForecast(this.value)" style="width:auto; min-width:240px;"></select>
      </div>
    </div>

    <!-- Forecast KPI Grid -->
    <div class="forecast-kpi-grid" id="forecast-kpi-grid"></div>

    <div class="grid" style="grid-template-columns: 1.3fr 0.9fr;">
      <div class="control-panel">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
          <h3 style="margin:0;" id="forecast-chart-title">30-Day Depletion & Restock Trajectory</h3>
          <span id="forecast-risk-pill" class="pill"></span>
        </div>
        <div id="forecast-chart-svg-wrap" style="width:100%; min-height:260px; background:var(--card); border-radius:12px; padding:12px; border:1px solid var(--line);"></div>

        <!-- What-If Stress Simulator -->
        <div style="background:rgba(59, 130, 246, 0.08); border:1px solid rgba(59, 130, 246, 0.25); border-radius:14px; padding:16px; margin-top:20px;">
          <div style="font-weight:800; font-size:0.95rem; color:var(--ink); margin-bottom:12px; display:flex; align-items:center; gap:6px;">
            <span>⚡ What-If Supply Stress Simulator</span>
            <span style="font-size:0.75rem; color:var(--mut); font-weight:normal;">(Live dynamic sensitivity test)</span>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div>
              <div style="display:flex; justify-content:space-between; font-size:0.82rem; margin-bottom:4px;">
                <span>Demand Surge:</span>
                <b id="sim-demand-val" style="color:var(--cob);">+0%</b>
              </div>
              <input type="range" id="sim-demand-slider" min="0" max="100" step="5" value="0" oninput="updateForecastSimulator()" style="width:100%; accent-color:var(--cob);">
            </div>
            <div>
              <div style="display:flex; justify-content:space-between; font-size:0.82rem; margin-bottom:4px;">
                <span>Distributor Delay:</span>
                <b id="sim-delay-val" style="color:var(--warn);">+0 Days</b>
              </div>
              <input type="range" id="sim-delay-slider" min="0" max="10" step="1" value="0" oninput="updateForecastSimulator()" style="width:100%; accent-color:var(--warn);">
            </div>
          </div>
          <div id="sim-impact-msg" style="font-size:0.82rem; color:var(--ok); margin-top:10px; font-weight:600;">
            Status: Standard inventory depletion trajectory active.
          </div>
        </div>
      </div>

      <div>
        <div class="control-panel">
          <h3 style="margin-top:0;">Root Causes & Depletion Drivers</h3>
          <div id="forecast-root-causes"></div>

          <h3 style="margin:20px 0 8px;">Regional Pharmacy Stockout Countdown</h3>
          <div id="forecast-pharm-table" style="max-height:360px; overflow-y:auto;"></div>
        </div>
      </div>
    </div>

    <!-- Regional Shortage Risk & Category Contribution Pie Charts -->
    <div class="grid" style="margin-top:20px; grid-template-columns: 1fr 1fr;">
      <div class="control-panel">
        <h3 style="margin-top:0; display:flex; align-items:center; gap:8px;">
          <span>🥧 Regional Shortage Risk Tiers</span>
        </h3>
        <p style="color:var(--mut); font-size:0.8rem; margin-bottom:14px;">Distribution of all 40 monitored medicines across Kanchipuram by stockout hazard level.</p>
        <div id="pie-risk-chart-wrap" style="min-height:220px; display:flex; justify-content:center; align-items:center;"></div>
      </div>
      <div class="control-panel">
        <h3 style="margin-top:0; display:flex; align-items:center; gap:8px;">
          <span>🥧 Shortage Impact by Category</span>
        </h3>
        <p style="color:var(--mut); font-size:0.8rem; margin-bottom:14px;">Relative share of depleted pharmacy stock across therapeutic classes.</p>
        <div id="pie-category-chart-wrap" style="min-height:220px; display:flex; justify-content:center; align-items:center;"></div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 5: MEDICINE PRICE COMPARISON          -->
  <!-- ========================================== -->
  <section id="v-compare" hidden>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:18px;">
      <div>
        <h1 style="margin:0 0 4px;">💰 Medicine Price Comparison & Generic Savings</h1>
        <p class="lede" style="margin:0;">Compare branded retail prices vs PMBJP Jan Aushadhi generic substitutes across Kanchipuram pharmacies.</p>
      </div>
      <div style="display:flex; align-items:center; gap:8px;">
        <label style="margin:0; font-size:0.82rem;">Select Medicine:</label>
        <select id="compare-med-select" onchange="loadPriceComparison(this.value)" style="width:auto; min-width:240px;"></select>
      </div>
    </div>

    <!-- Side-by-Side Hero Comparison -->
    <div id="compare-hero-wrap"></div>

    <!-- Chronic Patient Savings Calculator -->
    <div id="chronic-calc-wrap"></div>

    <!-- Pharmacy Price Leaderboard -->
    <div class="control-panel" style="margin-top:24px;">
      <h3 style="margin-top:0;">Pharmacy Price Leaderboard (Ranked Lowest to Highest)</h3>
      <p class="lede">Real-time pharmacy discounts, verified stock, and final doorstep delivery price.</p>
      <div id="pharm-price-table-wrap"></div>
    </div>

    <!-- Branded Substitutes Grid -->
    <div class="control-panel" style="margin-top:20px;">
      <h3 style="margin-top:0;">Same-Salt Branded Alternatives</h3>
      <div id="branded-subs-wrap"></div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 6: RESTOCK ALERTS & NOTIFICATIONS     -->
  <!-- ========================================== -->
  <section id="v-alerts" hidden>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:20px;">
      <div>
        <h1 style="margin:0 0 4px;">🔔 Restock Alerts & Notification Center</h1>
        <p class="lede" style="margin:0;">Proactive availability subscriptions, low-stock warnings, and real-time SMS & WhatsApp alerts.</p>
      </div>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <button type="button" class="btn-action btn-delivery" onclick="openCreateAlertModal()">
          ➕ Create Restock Alert
        </button>
        <button type="button" class="btn-action btn-simulate-restock" onclick="triggerSimulatedRestock()">
          ⚡ Simulate Restock Event (Demo)
        </button>
      </div>
    </div>

    <div class="grid">
      <div>
        <h3 style="margin-top:0; display:flex; align-items:center; gap:8px;">
          <span>Delivered Restock Notifications</span>
          <span id="notif-count-pill" class="pill" style="background:var(--cob);">0</span>
        </h3>
        <div id="notifications-feed"></div>
      </div>
      <div>
        <h3 style="margin-top:0; display:flex; align-items:center; gap:8px;">
          <span>Active Alert Subscriptions</span>
          <span id="active-alerts-count-pill" class="pill" style="background:var(--ok);">0</span>
        </h3>
        <div id="subscriptions-list"></div>
      </div>
    </div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 7: DELIVERY ORDERS                    -->
  <!-- ========================================== -->
  <section id="v-orders" hidden>
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
      <div>
        <h1 style="margin:0 0 4px;">🛵 Doorstep Delivery Orders</h1>
        <p class="lede" style="margin:0;">Track placed medicine orders & manage Pay on Delivery (Cash, UPI QR, Card) settlement.</p>
      </div>
      <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
        <button class="chip" onclick="renderOrdersPage()" style="display:inline-flex; align-items:center; gap:6px;">🔄 Refresh Orders</button>
        <button class="btn-action btn-delivery" onclick="switchTab('find')" style="padding:6px 12px; font-size:0.82rem;">🔍 Find Medicine to Order</button>
      </div>
    </div>
    <!-- Order Filter Pills -->
    <div style="display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; align-items:center;">
      <span style="font-size:0.8rem; color:var(--mut); font-weight:700;">Filter Orders:</span>
      <button class="chip active" id="order-filter-all" onclick="filterDeliveryOrders('all')">All (<span id="filter-cnt-all">0</span>)</button>
      <button class="chip" id="order-filter-pending" onclick="filterDeliveryOrders('pending')">⏳ Pending Payment (<span id="filter-cnt-pending">0</span>)</button>
      <button class="chip" id="order-filter-settled" onclick="filterDeliveryOrders('settled')">✅ Paid & Settled (<span id="filter-cnt-settled">0</span>)</button>
      <button class="chip" id="order-filter-upi" onclick="filterDeliveryOrders('upi')">📲 UPI</button>
      <button class="chip" id="order-filter-cash" onclick="filterDeliveryOrders('cash')">💵 Cash</button>
    </div>
    <div id="orders-container"></div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 8: RESTOCK DESK                       -->
  <!-- ========================================== -->
  <section id="v-stock" hidden>
    <h1>Restock Desk & POS Inventory Verification</h1>
    <p class="lede">For pharmacy managers: track out-of-stock risks, overdue supplier orders, and AI-suggested reorder quantities.</p>
    <label for="ph">Select Pharmacy</label>
    <select id="ph" style="max-width: 400px;"></select>
    <div class="sc" id="rs" style="margin-top:20px;"></div>
  </section>

  <!-- ========================================== -->
  <!-- VIEW 9: AI MODEL RELIABILITY               -->
  <!-- ========================================== -->
  <section id="v-model" hidden>
    <div id="rp"></div>
  </section>

  <!-- ========================================== -->
  <!-- MODALS                                     -->
  <!-- ========================================== -->

  <!-- Real-Time Stock Verification Modal -->
  <div id="stock-verify-modal" class="modal-backdrop" aria-hidden="true" onclick="closeStockVerifyModal()">
    <div class="modal-box" onclick="event.stopPropagation()">
      <div class="modal-header">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:1.6rem;">🛡️</span>
          <div>
            <h2 style="margin:0; font-size:1.15rem; font-weight:800;">Real-Time Stock Verification</h2>
            <div style="font-size:0.78rem; color:var(--mut);">Physical Shelf Count & Cloud POS Synchronization</div>
          </div>
        </div>
        <button class="btn-modal-close" onclick="closeStockVerifyModal()">✕</button>
      </div>
      <div class="modal-body" id="stock-verify-body"></div>
    </div>
  </div>

  <!-- Create Restock Alert Modal -->
  <div id="create-alert-modal" class="modal-backdrop" aria-hidden="true" onclick="closeCreateAlertModal()">
    <div class="modal-box" onclick="event.stopPropagation()">
      <div class="modal-header">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:1.6rem;">🔔</span>
          <div>
            <h2 style="margin:0; font-size:1.15rem; font-weight:800;">Create Restock Alert</h2>
            <div style="font-size:0.78rem; color:var(--mut);">Instant notifications when this medicine returns to stock</div>
          </div>
        </div>
        <button class="btn-modal-close" onclick="closeCreateAlertModal()">✕</button>
      </div>
      <form class="modal-body" onsubmit="submitCreateAlert(event)">
        <label for="alt-med-select">Medicine to Monitor</label>
        <select id="alt-med-select" required></select>

        <label for="alt-phone">Mobile Number for SMS / WhatsApp</label>
        <input type="tel" id="alt-phone" value="+91 98401 23456" required>

        <label for="alt-email">Email Address (Optional)</label>
        <input type="email" id="alt-email" placeholder="patient@example.com">

        <label for="alt-condition">Alert Trigger Condition</label>
        <select id="alt-condition">
          <option value="back_in_stock">Alert the moment medicine is back in stock</option>
          <option value="low_stock_warning">Alert when stock drops below 5 units (Early refill)</option>
          <option value="price_drop">Alert if generic Jan Aushadhi substitute arrives</option>
        </select>

        <label>Notification Channels</label>
        <div style="display:flex; gap:14px; flex-wrap:wrap; margin-top:6px;">
          <label style="margin:0; display:flex; align-items:center; gap:6px; text-transform:none; cursor:pointer;">
            <input type="checkbox" id="alt-ch-sms" checked style="width:auto;"> SMS Text
          </label>
          <label style="margin:0; display:flex; align-items:center; gap:6px; text-transform:none; cursor:pointer;">
            <input type="checkbox" id="alt-ch-wa" checked style="width:auto;"> WhatsApp
          </label>
          <label style="margin:0; display:flex; align-items:center; gap:6px; text-transform:none; cursor:pointer;">
            <input type="checkbox" id="alt-ch-push" checked style="width:auto;"> In-App Push
          </label>
        </div>

        <button type="submit" class="btn-confirm-delivery" style="margin-top:20px; width:100%; padding:14px; border:0; border-radius:12px; background:linear-gradient(135deg, #10b981 0%, #059669 100%); color:#fff; font-weight:800; cursor:pointer;">
          🔔 Activate Restock Alert Subscription
        </button>
      </form>
    </div>
  </div>

  <!-- Pay on Delivery (COD) Quick Modal -->
  <div id="del-modal" class="modal-backdrop" aria-hidden="true" onclick="closeDeliveryModal()">
    <div class="modal-box" onclick="event.stopPropagation()">
      <div class="modal-header">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:1.6rem;">🛵</span>
          <div>
            <h2 id="modal-title" style="margin:0; font-size:1.15rem; font-weight:800;">Pay on Delivery</h2>
            <div style="font-size:0.78rem; color:var(--mut);">Doorstep Medicine Delivery · Pay when received</div>
          </div>
        </div>
        <button class="btn-modal-close" onclick="closeDeliveryModal()">✕</button>
      </div>

      <div id="modal-form-view" class="modal-body">
        <div id="modal-pharm-med-summary" style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; margin-bottom:16px;"></div>

        <form id="delivery-order-form" onsubmit="submitDeliveryOrder(event)">
          <input type="hidden" id="del-pharm-id">
          <input type="hidden" id="del-med-id">

          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <label style="margin:0;">Quantity:</label>
            <div style="display:flex; align-items:center; gap:10px;">
              <button type="button" class="btn-action" onclick="changeDeliveryQty(-1)">-</button>
              <b id="del-qty-disp" style="font-size:1.1rem; min-width:24px; text-align:center;">1</b>
              <button type="button" class="btn-action" onclick="changeDeliveryQty(1)">+</button>
            </div>
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px;">
            <label for="del-name" style="margin:0;">Customer Name</label>
            <button type="button" class="chip" style="font-size:0.7rem; padding:2px 8px;" onclick="fastFillContact('Ramesh Kumar', '+91 98401 23456', '14, Gandhi Road, Kanchipuram')">⚡ Default Contact</button>
          </div>
          <input type="text" id="del-name" placeholder="e.g. Ramesh Kumar" value="Ramesh Kumar" required>

          <label for="del-phone">Mobile Phone (For Rider & OTP)</label>
          <input type="tel" id="del-phone" placeholder="e.g. +91 98401 23456" value="+91 98401 23456" required>

          <label for="del-address">Delivery Address (Doorstep)</label>
          <input type="text" id="del-address" placeholder="e.g. 14, Gandhi Road, Kanchipuram" value="14, Gandhi Road, Kanchipuram" required>

          <label style="margin-top:14px;">Select Payment Option on Delivery</label>
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:10px; margin-top:6px;">
            <label id="pod-card-cash" class="card pod-option-card active" onclick="selectPodMethod('Cash on Delivery')" style="margin:0; cursor:pointer; display:flex; flex-direction:column; gap:4px; padding:12px; border:2px solid var(--ok); background:rgba(16,185,129,0.08);">
              <div style="display:flex; align-items:center; gap:8px;">
                <input type="radio" name="pod-method" value="Cash on Delivery" checked onchange="selectPodMethod(this.value)" style="width:auto; margin:0;">
                <b style="font-size:0.9rem; color:var(--ink);">💵 Cash</b>
              </div>
              <span style="font-size:0.72rem; color:var(--mut);">Pay cash to rider at doorstep</span>
            </label>
            <label id="pod-card-upi" class="card pod-option-card" onclick="selectPodMethod('Doorstep UPI')" style="margin:0; cursor:pointer; display:flex; flex-direction:column; gap:4px; padding:12px; border:2px solid var(--line);">
              <div style="display:flex; align-items:center; gap:8px;">
                <input type="radio" name="pod-method" value="Doorstep UPI" onchange="selectPodMethod(this.value)" style="width:auto; margin:0;">
                <b style="font-size:0.9rem; color:var(--ink);">📲 UPI QR</b>
              </div>
              <span style="font-size:0.72rem; color:var(--mut);">GPay, PhonePe, Paytm, BHIM</span>
            </label>
            <label id="pod-card-card" class="card pod-option-card" onclick="selectPodMethod('Card on Delivery')" style="margin:0; cursor:pointer; display:flex; flex-direction:column; gap:4px; padding:12px; border:2px solid var(--line);">
              <div style="display:flex; align-items:center; gap:8px;">
                <input type="radio" name="pod-method" value="Card on Delivery" onchange="selectPodMethod(this.value)" style="width:auto; margin:0;">
                <b style="font-size:0.9rem; color:var(--ink);">💳 Card</b>
              </div>
              <span style="font-size:0.72rem; color:var(--mut);">Rider handheld mPOS tap/swipe</span>
            </label>
          </div>

          <button type="submit" class="go" id="btn-submit-del" style="margin-top:20px;">
            🛵 Confirm Pay on Delivery Order · ₹<span id="del-btn-amt">0</span>
          </button>
        </form>
      </div>

      <div id="modal-success-view" class="modal-body" style="display:none; text-align:center;">
        <div style="font-size:2.4rem;">🎉</div>
        <h3 style="margin:10px 0 4px; font-weight:800;">Order Placed Successfully!</h3>
        <p style="color:var(--mut); font-size:0.86rem; margin:0 0 16px;">Your medicine is being packed and dispatched.</p>
        <div id="succ-details" style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; text-align:left; font-size:0.88rem; margin-bottom:16px;"></div>
        <div style="display:flex; gap:10px; margin-bottom:12px;">
          <button type="button" class="btn-action" style="flex:1; justify-content:center; padding:10px;" id="succ-btn-upi">
            📲 Doorstep UPI QR
          </button>
          <button type="button" class="btn-action" style="flex:1; justify-content:center; padding:10px;" id="succ-btn-inv">
            🧾 Tax Invoice & Receipt
          </button>
        </div>
        <button type="button" class="btn-action" style="width:100%; justify-content:center; padding:12px;" onclick="closeDeliveryModal(); switchTab('orders');">
          📦 View in Delivery Orders
        </button>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal for Prescription Photo Preview -->
  <div id="rx-lightbox-modal" class="modal-backdrop" aria-hidden="true" onclick="closeRxLightbox()">
    <div style="max-width:90vw; max-height:90vh; position:relative; background:#131e27; padding:14px; border-radius:18px; border:1px solid var(--line); box-shadow:0 25px 60px rgba(0,0,0,0.8);" onclick="event.stopPropagation()">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <span style="font-weight:700; font-size:0.95rem; color:var(--ink);">📋 Prescription Preview</span>
        <button class="btn-modal-close" onclick="closeRxLightbox()">✕</button>
      </div>
      <img id="rx-lightbox-img" src="" alt="Prescription" style="max-width:100%; max-height:76vh; border-radius:10px; object-fit:contain; display:block;">
    </div>
  </div>

  <!-- Doorstep UPI Payment QR Modal -->
  <div id="upi-modal" class="modal-backdrop" aria-hidden="true" onclick="closeUpiModal()">
    <div class="upi-modal-box" onclick="event.stopPropagation()">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <div style="display:flex; align-items:center; gap:8px;">
          <span style="font-size:1.4rem;">📲</span>
          <div style="text-align:left;">
            <div style="font-weight:800; font-size:1.1rem; color:var(--ink);">Doorstep UPI Payment</div>
            <div style="font-size:0.75rem; color:var(--mut);">Scan with any UPI app on delivery arrival</div>
          </div>
        </div>
        <button class="btn-modal-close" onclick="closeUpiModal()">✕</button>
      </div>

      <div class="upi-qr-frame" id="upi-qr-container" style="display:flex; justify-content:center; align-items:center; min-height:200px;">
        <img id="upi-qr-img" src="" alt="UPI QR Code" style="width:200px; height:200px; display:none; border-radius:8px;">
        <div id="upi-qr-svg-wrap" style="width:200px; height:200px;"></div>
      </div>

      <div style="font-size:1.45rem; font-weight:800; color:var(--ok); margin-top:6px;">
        ₹<span id="upi-amt-disp">0</span>
      </div>
      <div style="font-size:0.82rem; color:var(--mut); margin:4px 0 10px;">
        Pay to VPA: <b id="upi-vpa-disp" style="color:var(--ink); font-family:monospace; background:rgba(14,165,233,0.1); padding:2px 6px; border-radius:6px;">medradar.pay@upi</b>
        <button type="button" class="chip" style="margin-left:6px; padding:2px 8px; font-size:0.72rem;" onclick="copyUpiId()">📋 Copy</button>
      </div>

      <div style="margin-bottom:12px;">
        <a id="upi-intent-link" href="#" class="chip" style="display:inline-flex; align-items:center; gap:6px; padding:6px 14px; text-decoration:none; font-weight:700; color:var(--cob); border-color:var(--cob);">
          📱 Open in Installed UPI App
        </a>
      </div>

      <div class="upi-badge-row">
        <span class="upi-pill">Google Pay</span>
        <span class="upi-pill">PhonePe</span>
        <span class="upi-pill">Paytm</span>
        <span class="upi-pill">BHIM UPI</span>
        <span class="upi-pill">CRED</span>
      </div>

      <div style="margin-top:16px; display:flex; flex-direction:column; gap:8px;">
        <button type="button" class="btn-action btn-delivery" style="justify-content:center; padding:12px; font-weight:800;" onclick="markPaidCurrentUpi()">
          ✅ Confirm UPI Received & Settle Order
        </button>
        <div style="display:flex; gap:8px;">
          <button type="button" class="btn-action" style="flex:1; justify-content:center; font-size:0.78rem;" onclick="switchToCashFromUpi()">
            💵 Switch to Cash
          </button>
          <button type="button" class="btn-action" style="flex:1; justify-content:center; font-size:0.78rem;" onclick="settleCurrentWithCard()">
            💳 Settle via Card
          </button>
        </div>
        <button type="button" class="btn-action" style="justify-content:center; border:none; color:var(--mut);" onclick="closeUpiModal()">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- Doorstep Cash Payment Settlement Modal -->
  <div id="cash-modal" class="modal-backdrop" aria-hidden="true" onclick="closeCashModal()">
    <div class="modal-box" onclick="event.stopPropagation()" style="max-width:440px;">
      <div class="modal-header">
        <div style="display:flex; align-items:center; gap:10px;">
          <span style="font-size:1.6rem;">💵</span>
          <div>
            <h2 style="margin:0; font-size:1.15rem; font-weight:800;">Doorstep Cash Payment</h2>
            <div style="font-size:0.78rem; color:var(--mut);">Physical Cash Handover & Change Settlement</div>
          </div>
        </div>
        <button class="btn-modal-close" onclick="closeCashModal()">✕</button>
      </div>

      <div class="modal-body">
        <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; margin-bottom:16px; text-align:center;">
          <span style="font-size:0.75rem; color:var(--mut); text-transform:uppercase; font-weight:700;">Exact Cash Amount Due</span>
          <div style="font-size:2.2rem; font-weight:800; color:var(--ok); margin-top:2px;">₹<span id="cash-amt-due">0</span></div>
          <div id="cash-order-info" style="font-size:0.8rem; color:var(--mut); margin-top:4px;"></div>
        </div>

        <label for="cash-tendered-input" style="font-weight:700;">Cash Tendered by Customer (₹)</label>
        <input type="number" id="cash-tendered-input" oninput="calculateCashChange()" style="font-size:1.25rem; font-weight:800; color:var(--ink); padding:10px; width:100%; border-radius:10px; border:1px solid var(--line); background:var(--panel); margin-bottom:8px;" placeholder="Enter amount handed">

        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-bottom:14px;">
          <button type="button" class="chip" onclick="setTenderedAmount('exact')">Exact Change</button>
          <button type="button" class="chip" onclick="setTenderedAmount(500)">₹500</button>
          <button type="button" class="chip" onclick="setTenderedAmount(1000)">₹1,000</button>
          <button type="button" class="chip" onclick="setTenderedAmount(2000)">₹2,000</button>
        </div>

        <div id="cash-change-box" style="background:rgba(59,130,246,0.08); border:1px solid rgba(59,130,246,0.3); border-radius:12px; padding:12px 16px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div style="font-size:0.75rem; color:var(--mut); text-transform:uppercase; font-weight:700;">Change to Return:</div>
            <b id="cash-change-disp" style="font-size:1.3rem; color:var(--cob);">₹0</b>
          </div>
          <span id="cash-status-note" style="font-size:0.8rem; color:var(--ok); font-weight:700;">Ready to Settle</span>
        </div>

        <div style="display:flex; flex-direction:column; gap:8px;">
          <button type="button" class="btn-action btn-delivery" style="justify-content:center; padding:12px; font-weight:800;" onclick="confirmCashPayment()">
            ✅ Confirm Cash Received & Settle Order
          </button>
          <div style="display:flex; gap:8px;">
            <button type="button" class="btn-action" style="flex:1; justify-content:center; font-size:0.78rem;" onclick="switchToUpiFromCash()">
              📲 Switch to UPI QR
            </button>
            <button type="button" class="btn-action" style="flex:1; justify-content:center; font-size:0.78rem;" onclick="settleCurrentWithCard()">
              💳 Settle via Card
            </button>
          </div>
          <button type="button" class="btn-action" style="justify-content:center; border:none; color:var(--mut);" onclick="closeCashModal()">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Medical Tax Invoice & Doorstep Cash Receipt Modal -->
