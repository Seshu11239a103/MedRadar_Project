    availability_pie: [
      { label: "In Stock (≥85%)", count: 462, pct: 64.2, color: "#10b981" },
      { label: "Call Ahead (55-84%)", count: 156, pct: 21.6, color: "#f59e0b" },
      { label: "Likely Out (<55%)", count: 102, pct: 14.2, color: "#ef4444" }
    ],
    category_shortage_pie: [
      { category: "Diabetes", label: "Diabetes", count: 28, pct: 27.5, color: "#ec4899" },
      { category: "Heart & BP", label: "Heart & BP", count: 22, pct: 21.6, color: "#f43f5e" },
      { category: "Breathing", label: "Breathing", count: 18, pct: 17.6, color: "#06b6d4" },
      { category: "Antibiotics", label: "Antibiotics", count: 14, pct: 13.7, color: "#8b5cf6" },
      { category: "Fever & pain", label: "Fever & pain", count: 11, pct: 10.8, color: "#3b82f6" },
      { category: "Stomach", label: "Stomach", count: 9, pct: 8.8, color: "#f59e0b" }
    ],
    shortage_risk_pie: [
      { label: "Critical (<48h)", count: 5, pct: 12.5, color: "#ef4444" },
      { label: "High Risk (3-7d)", count: 8, pct: 20.0, color: "#f97316" },
      { label: "Moderate (7-14d)", count: 12, pct: 30.0, color: "#eab308" },
      { label: "Stable (>14d)", count: 15, pct: 37.5, color: "#10b981" }
    ],
    ai_trip_pie: [
      { label: "Successful Trips", pct: 96.7, color: "#10b981" },
      { label: "Wasted Journeys", pct: 3.3, color: "#ef4444" }
    ],
    near_trip_pie: [
      { label: "Successful Trips", pct: 84.5, color: "#3b82f6" },
      { label: "Wasted Journeys", pct: 15.5, color: "#f43f5e" }
    ],
    total_medicines: 40,
    total_pharmacies: 18
  };
}

function localShortageHeatmap(medId) {
  const isAll = (medId === 'all' || !medId);
  const m = isAll ? null : (B.medicines.find(x => x.id === parseInt(medId)) || B.medicines[0]);
  const medSeed = m ? m.id * 19 : 73;

  const areas = B.areas.map((a, i) => {
    const rate = Math.min(65, Math.max(6, ((i * 23 + medSeed) % 58) + 7));
    const severity = rate >= 35 ? 'CRITICAL' : rate >= 22 ? 'ELEVATED' : rate >= 12 ? 'MODERATE' : 'LOW';
    const color = severity === 'CRITICAL' ? '#ef4444' : severity === 'ELEVATED' ? '#f97316' : severity === 'MODERATE' ? '#eab308' : '#10b981';

    const localPharms = B.pharmacies.filter(p => p.area.toLowerCase().includes(a.name.split(' ')[0].toLowerCase())).slice(0, 3);
    const pharms = localPharms.length ? localPharms : [B.pharmacies[i % B.pharmacies.length]];

    const depletedMeds = [
      B.medicines[(i * 3 + 6) % 40].brand,
      B.medicines[(i * 7 + 22) % 40].brand,
      B.medicines[(i * 5 + 14) % 40].brand
    ];

    return {
      id: i,
      name: a.name,
      lat: a.lat,
      lon: a.lon,
      shortage_rate: rate,
      severity: severity,
      color: color,
      heat_intensity: rate / 100,
      pharmacy_count: pharms.length,
      pharmacies: pharms,
      depleted_medicines: depletedMeds
    };
  });

  const avgRate = Math.round(areas.reduce((s, x) => s + x.shortage_rate, 0) / areas.length);
  return {
    areas: areas,
    citywide_average_shortage: avgRate,
    medicine: m ? m.brand : 'Citywide Aggregate (All 40 Medicines)'
  };
}

function localForecastSummary() {
  return {
    summary: {
      critical_count: 5,
      high_risk_count: 8,
      moderate_count: 12,
      stable_count: 15,
      average_network_cover_days: 9.4,
      supply_stress_index: 68
    }
  };
}

function localMedicineForecast(medId) {
  const m = B.medicines.find(x => x.id === parseInt(medId)) || B.medicines[0];
  const mId = m.id;
  const totalStock = ((mId * 13 + 37) % 65) + 18;
  const dailyDem = Math.round((2.5 + ((mId * 7) % 35) / 10) * 10) / 10;
  const coverDays = Math.round((totalStock / dailyDem) * 10) / 10;
  const riskLevel = coverDays < 3 ? 'CRITICAL' : coverDays < 7 ? 'HIGH RISK' : coverDays < 12 ? 'MODERATE' : 'STABLE';
  const restockDay = ((mId * 3) % 6) + 3;
  const incoming = ((mId * 17) % 40) + 20;

  const trajectory = [0, 1, 2, 3, 5, 7, 10, 14, 21, 30].map(d => {
    const burn = d * dailyDem;
    const inc = d >= restockDay ? incoming : 0;
    const stock = Math.max(0, Math.round(totalStock - burn + inc));
    return {
      day: d,
      label: d === 0 ? "Today" : `+${d}d`,
      projected_stock: stock,
      is_depleted: stock === 0
    };
  });

  const rootCauses = [
    m.is_emergency ? "High seasonal emergency casualty demand across Kanchipuram district hospital cluster" : "Active pharmaceutical ingredient (API) shipment delay from national formulation depot",
    "Distributor delivery vehicle cycle bottleneck on Chennai-Bengaluru highway artery",
    `Local dispensary reorder buffer below 14-day threshold (Current regional reserve: ${coverDays} days)`
  ];

  const breakdown = B.pharmacies.map((p, idx) => {
    const pStock = Math.max(0, Math.round(((totalStock * (idx + 3)) % 19)));
    const pDem = Math.max(0.5, Math.round((dailyDem / 4 + ((idx * 2) % 3)) * 10) / 10);
    const pCover = Math.round((pStock / pDem) * 10) / 10;
    return {
      pharmacy_id: p.id,
      name: p.name,
      area: p.area,
      stock: pStock,
      daily_demand: pDem,
      cover_days: pCover,
      status: pStock === 0 ? "Depleted" : pCover < 3 ? "Urgent Reorder" : "Stocked"
    };
  });

  return {
    medicine: m,
    risk_level: riskLevel,
    total_regional_stock: totalStock,
    total_daily_demand: dailyDem,
    cover_days: coverDays,
    pending_incoming_units: incoming,
    restock_expected_in_days: restockDay,
    trajectory: trajectory,
    root_causes: rootCauses,
    pharmacy_breakdown: breakdown
  };
}

function localPriceComparison(medId) {
  const m = B.medicines.find(x => x.id === parseInt(medId)) || B.medicines[0];
  const basePrice = m.price;
  const mrp = m.mrp || Math.round(basePrice * 1.15);
  const genPrice = m.generic_price || Math.round(basePrice * 0.28);
  const genName = m.generic_name || `Generic ${m.salt} ${m.strength}`;
  const savingsPct = m.savings_pct || Math.round((1 - genPrice / basePrice) * 100);

  const janAushadhi = {
    generic_name: genName,
    salt: m.salt,
    strength: m.strength,
    price: genPrice,
    mrp: mrp,
    savings_pct: savingsPct,
    savings_amount: Math.round(basePrice - genPrice),
    kendra_name: "PMBJP Jan Aushadhi Kendra, Gandhi Road, Kanchipuram",
    kendra_address: "Opp. District Headquarters Hospital, Gandhi Road, Kanchipuram",
    kendra_phone: "+91 94432 87654",
    bioequivalence_rating: "CDSCO / NABL Certified 100% Bioequivalent Formulation"
  };

  const pharmPrices = B.pharmacies.map((p, i) => {
    const disc = p.discount_pct || (i % 2 === 0 ? 12 : 8);
    const finalPrice = Math.max(10, Math.round(basePrice * (1 - disc / 100)));
    const inStock = ((p.id * 11 + m.id * 7) % 10) > 2;
    return {
      pharmacy_id: p.id,
      name: p.name,
      area: p.area,
      phone: p.phone,
      is_24x7: p.is_24x7,
      discount_pct: disc,
      final_price: finalPrice,
      base_mrp: mrp,
      is_in_stock: inStock,
      stock_units: inStock ? ((p.id * 5 + m.id * 3) % 18 + 2) : 0
    };
  }).sort((a, b) => a.final_price - b.final_price);

  const brandAlternatives = B.medicines
    .filter(x => x.id !== m.id && x.salt === m.salt)
    .map(alt => ({
      med_id: alt.id,
      brand: alt.brand,
      strength: alt.strength,
      price: alt.price,
      price_diff: alt.price - basePrice,
      is_cheaper: alt.price < basePrice,
      savings_vs_target: Math.max(0, basePrice - alt.price)
    }));

  return {
    medicine: m,
    jan_aushadhi_generic: janAushadhi,
    pharmacy_prices: pharmPrices,
    branded_alternatives: brandAlternatives
  };
}

function localEmergencyFinder(lat, lon, category) {
  const emMeds = B.medicines.filter(m => m.is_emergency);
  const toRad = deg => deg * Math.PI / 180;

  const nearestPharmacies = B.pharmacies.map(p => {
    const dLat = toRad(p.lat - lat);
    const dLon = toRad(p.lon - lon);
    const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat)) * Math.cos(toRad(p.lat)) * Math.sin(dLon/2)**2;
    const dKm = Math.round(6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)) * 10) / 10;
    return {
      ...p,
      dist_km: dKm,
      eta_min: Math.max(4, Math.round(dKm * 2.2)),
      emergency_items: emMeds.slice(0, 4).map(em => ({
        id: em.id,
        brand: em.brand,
        strength: em.strength,
        stock_units: ((p.id * 7 + em.id * 11) % 15) + 3
      })),
      whatsapp_sos_url: `https://wa.me/${p.phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`EMERGENCY SOS: Inquiring about immediate life-saving medicine availability at ${p.name}`)}`,
      google_maps_url: `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lon}`
    };
  }).sort((a, b) => (b.is_24x7 ? 1 : 0) - (a.is_24x7 ? 1 : 0) || a.dist_km - b.dist_km).slice(0, 6);

  const helplines = [
    { title: "Ambulance / Emergency Trauma", number: "108", desc: "Government 24x7 centralized free ambulance dispatch" },
    { title: "Kanchipuram District HQ Casualty Desk", number: "044-27222222", desc: "24-Hour Emergency Medical Ward, Gandhi Road" },
    { title: "National Emergency Helpline", number: "112", desc: "All-in-one Police, Fire & Emergency Response" },
    { title: "Tamil Nadu Poison & Antidote Centre", number: "1800-425-1213", desc: "Toll-free 24x7 toxicology assistance" }
  ];

  return {
    nearest_emergency_pharmacies: nearestPharmacies,
    emergency_helplines: helplines,
    total_emergency_pharmacies: nearestPharmacies.length
  };
}

function localAlerts() {
  return {
    total_active_alerts: 3,
    unread_notifications: 2,
    alerts: [
      { id: "ALT-10821", med_id: 6, med_name: "Lantus Solostar Pen", phone: "+91 98401 23456", condition: "back_in_stock", channels: ["SMS", "WhatsApp"], status: "ACTIVE", created_at: "Today" },
