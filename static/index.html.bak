  // Pharmacy Price Leaderboard
  $('#pharm-price-table-wrap').innerHTML = `
    <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--line); text-align:left; color:var(--mut);">
          <th style="padding:8px;">Pharmacy</th>
          <th style="padding:8px;">Area</th>
          <th style="padding:8px;">Retail Discount</th>
          <th style="padding:8px;">Final Price</th>
          <th style="padding:8px;">Stock Status</th>
          <th style="padding:8px; text-align:right;">Action</th>
        </tr>
      </thead>
      <tbody>
        ${data.pharmacy_prices.map(p => `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:10px 8px;"><b>${p.name}</b> ${p.is_24x7 ? '<span class="badge-24x7">24x7</span>' : ''}</td>
            <td style="padding:10px 8px; color:var(--mut);">${p.area}</td>
            <td style="padding:10px 8px;"><b style="color:var(--ok);">${p.discount_pct}% OFF</b></td>
            <td style="padding:10px 8px;"><b style="font-size:1rem; color:var(--ink);">₹${p.final_price}</b> <span style="font-size:0.72rem; color:var(--mut); text-decoration:line-through;">₹${p.base_mrp}</span></td>
            <td style="padding:10px 8px;"><span class="pill" style="font-size:0.7rem; background:${p.is_in_stock ? 'var(--ok)' : 'var(--bad)'}">${p.is_in_stock ? `${p.stock_units} in stock` : 'Out of stock'}</span></td>
            <td style="padding:10px 8px; text-align:right;">
              <button class="btn-action btn-delivery" style="padding:5px 10px; font-size:0.76rem;" onclick="openDeliveryModal(${p.pharmacy_id}, ${m.id})">
                🛵 Order ₹${p.final_price}
              </button>
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;

  // Same-salt branded alternatives
  if (data.branded_alternatives && data.branded_alternatives.length) {
    $('#branded-subs-wrap').innerHTML = `
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:12px; margin-top:10px;">
        ${data.branded_alternatives.map(b => `
          <div style="background:var(--card); border:1px solid var(--line); border-radius:12px; padding:12px;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
              <div>
                <b style="font-size:1rem; color:var(--ink);">${b.brand}</b>
                <div style="font-size:0.78rem; color:var(--mut);">${b.strength}</div>
              </div>
              <b style="font-size:1.1rem; color:var(--ok);">₹${b.price}</b>
            </div>
            <div style="font-size:0.76rem; color:${b.is_cheaper ? 'var(--ok)' : 'var(--mut)'}; margin-top:6px;">
              ${b.is_cheaper ? `💰 ₹${b.savings_vs_target} cheaper than ${m.brand}` : `₹${Math.abs(b.price_diff)} vs ${m.brand}`}
            </div>
          </div>
        `).join('')}
      </div>
    `;
  } else {
    $('#branded-subs-wrap').innerHTML = `<p style="color:var(--mut); font-size:0.85rem;">No other commercial brand equivalents found for this active salt.</p>`;
  }
}

function updateChronicCalc(brandPrice, genericPrice) {
  const qty = parseInt($('#calc-qty-slider').value);
  const annualSaved = (brandPrice - genericPrice) * qty * 12;
  $('#calc-annual-saved').textContent = `₹${Math.round(annualSaved)}`;
}

// =========================================================================
// FEATURE 4: MEDICINE SHORTAGE HEATMAP
// =========================================================================
async function renderHeatmapPage() {
  const filterSelect = $('#heatmap-med-filter');
  if (!filterSelect.innerHTML) {
    filterSelect.innerHTML = `<option value="all">Citywide Aggregate (All 40 Medicines)</option>` +
      B.medicines.map(m => `<option value="${m.id}">${m.brand} (${m.salt})</option>`).join('');
  }

  const selectedMed = filterSelect ? (filterSelect.value || 'all') : 'all';
  let data = await api(`/api/shortage_heatmap?med_id=${selectedMed}`);
  if (!data) data = localShortageHeatmap(selectedMed);

  const critZones = data.areas.filter(a => a.severity === 'CRITICAL').length;
  const safeZones = data.areas.filter(a => a.severity === 'LOW').length;

  $('#heatmap-kpi-bar').innerHTML = `
    <div class="kpi-card" style="border-left:5px solid var(--cob);">
      <span style="color:var(--mut); font-size:0.8rem; font-weight:700;">CITYWIDE SHORTAGE INDEX</span>
      <b style="color:var(--cob);">${data.citywide_average_shortage}%</b>
      <span style="font-size:0.75rem; color:var(--mut);">Average regional stockout rate</span>
    </div>
    <div class="kpi-card" style="border-left:5px solid var(--bad);">
      <span style="color:var(--mut); font-size:0.8rem; font-weight:700;">CRITICAL SHORTAGE ZONES</span>
      <b style="color:var(--bad);">${critZones} Areas</b>
      <span style="font-size:0.75rem; color:var(--mut);">&gt;35% of pharmacies stockless</span>
    </div>
    <div class="kpi-card" style="border-left:5px solid var(--ok);">
      <span style="color:var(--mut); font-size:0.8rem; font-weight:700;">SURPLUS / SAFE ZONES</span>
      <b style="color:var(--ok);">${safeZones} Areas</b>
      <span style="font-size:0.75rem; color:var(--mut);">Healthy inventory buffer</span>
    </div>
  `;

  renderHeatmapSvg(data.areas);
  if (data.areas.length) inspectHeatmapZone(data.areas[0].id, data.areas);
}

function renderHeatmapSvg(areas) {
  // Map coordinates onto 760 x 520 SVG
  const minLat = 12.68, maxLat = 13.10;
  const minLon = 79.67, maxLon = 80.28;

  const pts = areas.map(a => {
    const x = 50 + ((a.lon - minLon) / (maxLon - minLon)) * 660;
    const y = 470 - ((a.lat - minLat) / (maxLat - minLat)) * 420;
    return { ...a, x, y };
  });

  // Arterial connector lines representing district highway arteries
  let lines = '';
  for (let i = 0; i < pts.length; i++) {
    for (let j = i + 1; j < pts.length; j++) {
      const d = Math.hypot(pts[i].x - pts[j].x, pts[i].y - pts[j].y);
      if (d < 120) {
        lines += `<line x1="${pts[i].x}" y1="${pts[i].y}" x2="${pts[j].x}" y2="${pts[j].y}" stroke="var(--line)" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.4"/>`;
      }
    }
  }

  let nodes = pts.map(p => {
    const rGlow = 22 + p.heat_intensity * 26;
    return `
      <g style="cursor:pointer;" onclick="inspectHeatmapZone(${p.id})">
        <!-- Radial heat blur glow -->
        <circle cx="${p.x}" cy="${p.y}" r="${rGlow}" fill="${p.color}" opacity="${0.18 + p.heat_intensity * 0.2}"/>
        <circle cx="${p.x}" cy="${p.y}" r="14" fill="${p.color}" opacity="0.35"/>
        <circle cx="${p.x}" cy="${p.y}" r="7" fill="${p.color}" stroke="#fff" stroke-width="1.5"/>
        <text x="${p.x}" y="${p.y - 14}" font-size="10" font-weight="700" text-anchor="middle" fill="var(--ink)">${p.name.split('(')[0].trim()}</text>
        <text x="${p.x}" y="${p.y + 20}" font-size="9" font-weight="800" text-anchor="middle" fill="${p.color}">${p.shortage_rate}%</text>
        <title>${p.name}: ${p.shortage_rate}% shortage (${p.severity})</title>
      </g>
    `;
  }).join('');

  $('#heatmap-svg').innerHTML = `
    <!-- Map Background Grid -->
    <rect width="760" height="520" fill="#080e14" rx="12"/>
    ${lines}
    ${nodes}
  `;

  window.__heatmapAreas = areas;
}

function inspectHeatmapZone(zoneId, areaList) {
  const areas = areaList || window.__heatmapAreas || [];
  const z = areas.find(a => a.id === zoneId) || areas[0];
  if (!z) return;

  $('#zone-inspector-panel').innerHTML = `
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
      <div>
        <h3 style="margin:0 0 4px; font-size:1.2rem; color:var(--ink);">${z.name}</h3>
        <div style="font-size:0.8rem; color:var(--mut);">GPS: ${z.lat.toFixed(4)}, ${z.lon.toFixed(4)}</div>
      </div>
      <span class="pill" style="background:${z.color};">${z.severity}</span>
    </div>

    <div style="background:var(--card); border:1px solid var(--line); border-radius:12px; padding:14px; margin:14px 0;">
      <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
        <span style="color:var(--mut);">Local Shortage Intensity:</span>
        <b style="color:${z.color}; font-size:1.1rem;">${z.shortage_rate}%</b>
      </div>
      <div style="display:flex; justify-content:space-between;">
        <span style="color:var(--mut);">Active Pharmacies:</span>
        <b>${z.pharmacy_count} in zone</b>
      </div>
    </div>

    <h4 style="margin:14px 0 6px; font-size:0.88rem;">Depleted Medicines in this Zone:</h4>
    <div style="display:flex; flex-wrap:wrap; gap:6px;">
      ${z.depleted_medicines.map(d => `<span class="pill" style="background:rgba(239, 68, 68, 0.18); color:#f87171; border:1px solid rgba(239, 68, 68, 0.4); text-transform:none;">${d}</span>`).join('')}
    </div>

    <h4 style="margin:16px 0 6px; font-size:0.88rem;">Local Pharmacies:</h4>
    <div style="font-size:0.82rem;">
      ${z.pharmacies.map(p => `
        <div style="display:flex; justify-content:space-between; align-items:center; padding:6px 0; border-bottom:1px solid var(--line);">
          <span><b>${p.name}</b></span>
          <a class="btn-action btn-call" style="padding:3px 8px; font-size:0.75rem;" href="tel:${p.phone}">📞 Call</a>
        </div>
      `).join('')}
    </div>
  `;
}

// =========================================================================
// FEATURE 5: MEDICINE AVAILABILITY NOTIFICATION SYSTEM
// =========================================================================
async function renderAlertsPage() {
  let data = await api('/api/alerts');
  if (!data) data = localAlerts();

  $('#alerts-badge').textContent = data.unread_notifications || data.total_active_alerts;
  $('#notif-count-pill').textContent = data.notifications ? data.notifications.length : 0;
  $('#active-alerts-count-pill').textContent = data.total_active_alerts;

  // Render notifications feed
  if (data.notifications && data.notifications.length) {
    $('#notifications-feed').innerHTML = data.notifications.map(n => `
      <div class="alert-card" style="border-left:5px solid ${n.type === 'EMERGENCY_ALERT' ? 'var(--em-red)' : 'var(--ok)'}">
        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
          <b style="font-size:0.95rem; color:var(--ink);">${n.title}</b>
          <span style="font-size:0.72rem; color:var(--mut);">${n.time}</span>
        </div>
        <p style="font-size:0.84rem; color:var(--mut); margin:6px 0 10px;">${n.message}</p>
        <div style="display:flex; gap:8px;">
          <button class="btn-action btn-delivery" style="font-size:0.76rem; padding:4px 10px;" onclick="openDeliveryModal(${n.pharmacy_id}, ${n.med_id})">
            🛵 Order Pay on Delivery
          </button>
          <button class="btn-action btn-verify" style="font-size:0.76rem; padding:4px 10px;" onclick="openStockVerificationModal(${n.pharmacy_id}, ${n.med_id})">
            ⚡ Verify Shelf Stock
          </button>
        </div>
      </div>
    `).join('');
  } else {
    $('#notifications-feed').innerHTML = `<p style="color:var(--mut);">No delivered notifications yet.</p>`;
  }

  // Render subscriptions list
  if (data.alerts && data.alerts.length) {
    $('#subscriptions-list').innerHTML = data.alerts.map(a => `
      <div class="alert-card">
        <div style="display:flex; justify-content:space-between; align-items:flex-start;">
          <div>
            <b style="font-size:0.95rem; color:var(--ink);">${a.med_name}</b>
            <div style="font-size:0.78rem; color:var(--mut);">${a.phone} · Created: ${a.created_at}</div>
          </div>
          <span class="pill" style="background:var(--ok);">${a.status}</span>
        </div>
        <div style="font-size:0.8rem; color:var(--mut); margin-top:6px;">
          Trigger: <b>${a.condition.replace(/_/g, ' ')}</b> · Radius: ${a.radius_km || 15}km · Channels: ${Array.isArray(a.channels) ? a.channels.join(', ').toUpperCase() : a.channels}
        </div>
        <div style="margin-top:10px; display:flex; justify-content:flex-end;">
          <button class="btn-action" style="font-size:0.75rem; color:var(--bad); border-color:var(--bad);" onclick="deleteAlert('${a.id}')">
            ✕ Cancel Alert
          </button>
        </div>
      </div>
    `).join('');
  } else {
    $('#subscriptions-list').innerHTML = `<p style="color:var(--mut);">No active subscriptions.</p>`;
  }
}

function openCreateAlertModal(medId) {
  $('#alt-med-select').innerHTML = B.medicines.map(m =>
    `<option value="${m.id}" ${medId !== undefined && m.id === medId ? 'selected' : ''}>${m.brand} (${m.salt} ${m.strength})</option>`
  ).join('');
  $('#create-alert-modal').classList.add('active');
}

function closeCreateAlertModal() {
  $('#create-alert-modal').classList.remove('active');
}

async function submitCreateAlert(e) {
  e.preventDefault();
  const medId = parseInt($('#alt-med-select').value);
  const phone = $('#alt-phone').value;
  const email = $('#alt-email').value;
  const condition = $('#alt-condition').value;

  const channels = [];
  if ($('#alt-ch-sms').checked) channels.push('sms');
  if ($('#alt-ch-wa').checked) channels.push('whatsapp');
  if ($('#alt-ch-push').checked) channels.push('in_app');

  const res = await api('/api/subscribe_alert', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ med_id: medId, phone, email, condition, channels })
  });

  if (res && res.status === 'success') {
    closeCreateAlertModal();
    showToast("Restock Alert Subscribed", res.message, "success");
    renderAlertsPage();
  }
}

async function deleteAlert(alertId) {
  const res = await api('/api/delete_alert', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: alertId })
  });
  if (res && res.status === 'success') {
    showToast("Alert Cancelled", `Subscription ${alertId} removed.`, "info");
    renderAlertsPage();
  }
}

async function triggerSimulatedRestock() {
  const res = await api('/api/trigger_restock_simulation', { method: 'POST' });
  if (res && res.status === 'success') {
    const ev = res.simulated_event;
    showToast(
      `🎉 Restock Event: ${ev.medicine}`,
      `${ev.added_units} units delivered to ${ev.pharmacy}. ${ev.matched_subscribers_alerted} subscriber(s) notified!`,
      "success",
      7000
    );
    renderAlertsPage();
  }
}

// =========================================================================
// FEATURE 6: EMERGENCY MEDICINE FINDER
// =========================================================================
async function renderEmergencyPage() {
  let lat = 12.8342, lon = 79.7036;
  if (currentGps) {
    lat = currentGps.lat;
    lon = currentGps.lon;
  }

  const query = `/api/emergency_finder?lat=${lat}&lon=${lon}${currentEmergencyFilter !== 'all' ? `&category=${currentEmergencyFilter}` : ''}`;
  let data = await api(query);
  if (!data) data = localEmergencyFinder(lat, lon, currentEmergencyFilter);

  // Render Helplines
  $('#em-helplines-wrap').innerHTML = data.emergency_helplines.map(h => `
    <div class="em-helpline-row">
      <div>
        <b style="font-size:0.92rem; color:var(--ink);">${h.title}</b>
        <div style="font-size:0.75rem; color:var(--mut);">${h.desc}</div>
      </div>
      <a class="btn-action" style="background:#e11d48; border-color:#f43f5e; color:#fff; font-weight:800; padding:6px 14px;" href="tel:${h.number.replace(/[^0-9]/g,'')}">
        📞 ${h.number}
      </a>
    </div>
  `).join('');

  // Render Emergency Pharmacies
  if (data.nearest_emergency_pharmacies && data.nearest_emergency_pharmacies.length) {
    $('#em-pharmacy-list').innerHTML = data.nearest_emergency_pharmacies.map(p => `
      <div class="emergency-card">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
          <div>
            <h3 style="margin:0 0 2px; font-size:1.15rem; color:#fff;">${p.name}</h3>
            <div style="color:#fca5a5; font-size:0.84rem;">
              ⚡ <b>${p.dist_km} km away (~${p.eta_min} min ETA)</b> · ${p.area}
              ${p.is_24x7 ? ' · <span class="badge-24x7">24x7 CASUALTY DESK</span>' : ''}
            </div>
          </div>
          <span class="pill" style="background:#e11d48;">Verified Stock</span>
        </div>

        <div style="background:rgba(0,0,0,0.25); border-radius:10px; padding:10px 12px; margin:10px 0;">
          <span style="font-size:0.75rem; color:var(--mut); text-transform:uppercase; font-weight:700;">In-Stock Life-Saving Drugs:</span>
          <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;">
            ${p.emergency_items.map(m => `
              <span class="pill" style="background:rgba(244, 63, 94, 0.2); color:#fecdd3; border:1px solid rgba(244, 63, 94, 0.4); text-transform:none;">
                <b>${m.brand}</b> (${m.strength}) · ${m.stock_units} units
              </span>
            `).join('')}
          </div>
        </div>

        <div class="action-bar" style="border-top-color:rgba(244, 63, 94, 0.25);">
          <a class="btn-action" style="background:#e11d48; color:#fff; border-color:#f43f5e; font-weight:800;" href="tel:${p.phone}">
            📞 1-Tap Emergency Call
          </a>
          <a class="btn-action btn-wa" href="${p.whatsapp_sos_url}" target="_blank">
            💬 WhatsApp SOS Dispatch
          </a>
          <a class="btn-action btn-map" href="${p.google_maps_url}" target="_blank">
            🗺️ GPS Route Directions
          </a>
          <button class="btn-action btn-delivery" onclick="openDeliveryModal(${p.id}, ${p.emergency_items[0].id})">
            🛵 15-Min Priority Courier
          </button>
        </div>
      </div>
    `).join('');
  } else {
    $('#em-pharmacy-list').innerHTML = `<p style="color:var(--mut);">No emergency pharmacies found within radius.</p>`;
  }
}

function filterEmergencyCategory(cat) {
  document.querySelectorAll('#em-chips .em-chip').forEach(c => c.classList.remove('active'));
  const btn = document.querySelector(`#em-chips .em-chip[data-em="${cat}"]`);
  if (btn) btn.classList.add('active');
  currentEmergencyFilter = cat;
  renderEmergencyPage();
}

function findEmergencyGps() {
  if (!navigator.geolocation) {
    showToast("GPS Error", "Geolocation not supported by device", "emergency");
    return;
  }
  showToast("Locating GPS", "Acquiring precision GPS position for nearest emergency dispensary...", "info");
  navigator.geolocation.getCurrentPosition(
    pos => {
      currentGps = { lat: pos.coords.latitude, lon: pos.coords.longitude };
      showToast("GPS Locked", `Coordinates: ${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)}`, "success");
      renderEmergencyPage();
    },
    err => {
      showToast("GPS Failed", "Defaulting to Kanchipuram Central HQ Hospital", "emergency");
      renderEmergencyPage();
    },
    { timeout: 7000 }
  );
}

