: 12.7935, "lon": 79.814}, {"name": "Sriperumbudur Hub", "lat": 12.968, "lon": 79.943}, {"name": "Chengalpattu Town", "lat": 12.6939, "lon": 79.9757}, {"name": "T. Nagar, Chennai", "lat": 13.0418, "lon": 80.2341}, {"name": "Adyar, Chennai", "lat": 13.0012, "lon": 80.2565}, {"name": "Anna Nagar, Chennai", "lat": 13.085, "lon": 80.2101}, {"name": "Velachery, Chennai", "lat": 12.9815, "lon": 80.218}, {"name": "Tambaram, Chennai", "lat": 12.9249, "lon": 80.1}, {"name": "Porur, Chennai", "lat": 13.0382, "lon": 80.1565}, {"name": "Guindy, Chennai", "lat": 13.0067, "lon": 80.2206}]};
let B = DEFAULT_BOOTSTRAP;
let currentGps = null;
let activeCat = 'all';
let currentForecastMed = 0;
let currentCompareMed = 0;
let currentEmergencyFilter = 'all';
let medicineKit = [];
let currentLang = 'en';

const ALL_TABS = ['find', 'emergency', 'heatmap', 'forecast', 'compare', 'alerts', 'orders', 'stock', 'model'];

// BILINGUAL LOCALIZATION (ENGLISH & TAMIL)
const I18N = {
  en: {
    find_tab: "🔍 Find & Verify",
    em_tab: "🚨 Emergency SOS",
    heat_tab: "🗺️ Shortage Heatmap",
    fore_tab: "📈 Shortage Forecast",
    comp_tab: "💰 Price Compare",
    alert_tab: "🔔 Alerts",
    orders_tab: "🛵 Orders",
    stock_tab: "📦 Restock Desk",
    model_tab: "📊 AI Model",
    sos_btn: "🚨 SOS FINDER",
    lang_btn: "🌐 தமிழ்"
  },
  ta: {
    find_tab: "🔍 மருந்து கண்டறி",
    em_tab: "🚨 அவசர SOS",
    heat_tab: "🗺️ தட்டுப்பாடு வரைபடம்",
    fore_tab: "📈 தட்டுப்பாடு கணிப்பு",
    comp_tab: "💰 விலை ஒப்பீடு",
    alert_tab: "🔔 நினைவூட்டல்",
    orders_tab: "🛵 டெலிவரி",
    stock_tab: "📦 இருப்பு மேலாண்மை",
    model_tab: "📊 AI மாதிரி",
    sos_btn: "🚨 அவசர உதவி",
    lang_btn: "🌐 English"
  }
};

function toggleLanguage() {
  currentLang = currentLang === 'en' ? 'ta' : 'en';
  applyLanguage();
}

function applyLanguage() {
  const t = I18N[currentLang] || I18N.en;
  const btn = $('#btn-lang');
  if (btn) btn.textContent = t.lang_btn;

  const tabs = document.querySelectorAll('nav button');
  if (tabs.length >= 9) {
    tabs[0].childNodes[0].textContent = t.find_tab + ' ';
    tabs[1].childNodes[0].textContent = t.em_tab;
    tabs[2].childNodes[0].textContent = t.heat_tab;
    tabs[3].childNodes[0].textContent = t.fore_tab;
    tabs[4].childNodes[0].textContent = t.comp_tab;
    tabs[5].childNodes[0].textContent = t.alert_tab + ' ';
    tabs[6].childNodes[0].textContent = t.orders_tab + ' ';
    tabs[7].childNodes[0].textContent = t.stock_tab;
    tabs[8].childNodes[0].textContent = t.model_tab;
  }
}

// TOAST NOTIFICATIONS
function showToast(title, message, type = 'info', duration = 5000) {
  const container = $('#toast-container');
  if (!container) return;
  const t = document.createElement('div');
  t.className = `toast-banner ${type === 'success' ? 'toast-success' : type === 'emergency' ? 'toast-emergency' : ''}`;
  t.innerHTML = `
    <div style="font-size:1.4rem; line-height:1;">${type === 'success' ? '🎉' : type === 'emergency' ? '🚨' : '🔔'}</div>
    <div style="flex:1;">
      <b style="font-size:0.9rem; display:block; margin-bottom:2px;">${title}</b>
      <div style="font-size:0.8rem; opacity:0.9;">${message}</div>
    </div>
    <button style="background:none; border:none; color:#fff; cursor:pointer; font-size:1rem;" onclick="this.parentElement.remove()">✕</button>
  `;
  container.appendChild(t);
  setTimeout(() => { if (t.parentElement) t.remove(); }, duration);
}

// CENTRAL TAB SWITCHER
function switchTab(tabName) {
  document.querySelectorAll('nav button').forEach(x => {
    x.setAttribute('aria-selected', x.dataset.v === tabName);
  });
  ALL_TABS.forEach(v => {
    const el = $('#v-' + v);
    if (el) el.hidden = (v !== tabName);
  });

  if (tabName === 'emergency') renderEmergencyPage();
  if (tabName === 'heatmap') renderHeatmapPage();
  if (tabName === 'forecast') renderForecastPage();
  if (tabName === 'compare') renderComparePage();
  if (tabName === 'alerts') renderAlertsPage();
  if (tabName === 'orders') renderOrdersPage();
  if (tabName === 'stock') stock();
  if (tabName === 'model') report();

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// API CALL HELPER
async function api(path, options) {
  try {
    const res = await fetch(path, options);
    if (!res.ok) throw new Error(`HTTP error ${res.status}`);
    return await res.json();
  } catch (e) {
    console.warn("API request failed:", path, e);
    return null;
  }
}

// INITIALIZATION
async function init() {
  const data = await api('/api/bootstrap');
  if (data && data.medicines && data.pharmacies) {
    B = data;
  }

  // Populate medicine dropdowns
  renderMedicineSelect();

  // Populate area dropdown
  $('#area').innerHTML = B.areas.map((a, i) =>
    `<option value="${i}">${a.name}</option>`
  ).join('');

  // Populate pharmacy dropdown in stock desk
  $('#ph').innerHTML = B.pharmacies.map(p =>
    `<option value="${p.id}">${p.name} (${p.area})</option>`
  ).join('');

  // Attach nav tab clicks
  document.querySelectorAll('nav button').forEach(b => {
    b.onclick = () => switchTab(b.dataset.v);
  });

  // Attach category filter checkbox buttons in Find view
  document.querySelectorAll('#cat-chips .chip').forEach(c => {
    c.onclick = () => {
      document.querySelectorAll('#cat-chips .chip').forEach(x => {
        x.classList.remove('active');
        x.textContent = x.textContent.replace('✓ ', '');
      });
      c.classList.add('active');
      if (!c.textContent.startsWith('✓')) {
        c.textContent = '✓ ' + c.textContent;
      }
      activeCat = c.dataset.cat;
      renderMedicineSelect();
      find();
    };
  });

  if ($('#med-select')) $('#med-select').onchange = () => { updateMedBadge(); find(); };
  if ($('#area')) $('#area').onchange = find;
  if ($('#rad')) {
    $('#rad').oninput = e => { if ($('#ro')) $('#ro').textContent = e.target.value; };
    $('#rad').onchange = find;
  }
  if ($('#subs')) {
    $('#subs').onchange = find;
    $('#subs').onclick = find;
  }
  if ($('#chk-display-pie')) {
    $('#chk-display-pie').onchange = handleVisCheckboxToggle;
  }
  if ($('#chk-display-radar')) {
    $('#chk-display-radar').onchange = handleVisCheckboxToggle;
  }
  if ($('#go')) $('#go').onclick = find;
  if ($('#btn-gps')) $('#btn-gps').onclick = getLocation;
  if ($('#ph')) $('#ph').onchange = stock;

  applyLanguage();
  updateOrdersBadge();
  updateKitBar();
  setVisualizerView('pie');

  // Initial search
  await find();
}

let currentVisView = 'pie';

function setVisualizerView(mode) {
  currentVisView = mode;
  document.querySelectorAll('.vis-view-tabs .chip').forEach(b => b.classList.remove('active'));
  const btn = $('#btn-view-' + mode);
  if (btn) btn.classList.add('active');

  const piePanel = $('#find-pie-panel');
  const radarPanel = $('#radar-box-panel');
  const chkPie = $('#chk-display-pie');
  const chkRadar = $('#chk-display-radar');

  if (mode === 'pie') {
    if (piePanel) piePanel.style.display = 'block';
    if (radarPanel) radarPanel.style.display = 'none';
    if (chkPie) chkPie.checked = true;
    if (chkRadar) chkRadar.checked = false;
  } else if (mode === 'radar') {
    if (piePanel) piePanel.style.display = 'none';
    if (radarPanel) radarPanel.style.display = 'flex';
    if (chkPie) chkPie.checked = false;
    if (chkRadar) chkRadar.checked = true;
  } else if (mode === 'both') {
    if (piePanel) piePanel.style.display = 'block';
    if (radarPanel) radarPanel.style.display = 'flex';
    if (chkPie) chkPie.checked = true;
    if (chkRadar) chkRadar.checked = true;
  }
}

function handleVisCheckboxToggle() {
  const chkPie = $('#chk-display-pie');
  const chkRadar = $('#chk-display-radar');
  const pieShow = chkPie ? chkPie.checked : true;
  const radarShow = chkRadar ? chkRadar.checked : true;

  const piePanel = $('#find-pie-panel');
  const radarPanel = $('#radar-box-panel');

  if (piePanel) piePanel.style.display = pieShow ? 'block' : 'none';
  if (radarPanel) radarPanel.style.display = radarShow ? 'flex' : 'none';

  document.querySelectorAll('.vis-view-tabs .chip').forEach(b => b.classList.remove('active'));
  if (pieShow && radarShow) {
    const btn = $('#btn-view-both');
    if (btn) btn.classList.add('active');
  } else if (pieShow) {
    const btn = $('#btn-view-pie');
    if (btn) btn.classList.add('active');
  } else if (radarShow) {
    const btn = $('#btn-view-radar');
    if (btn) btn.classList.add('active');
  }
}

function renderMedicineSelect() {
  let list = B.medicines;
  if (activeCat === 'em') {
    list = list.filter(m => m.is_emergency);
  } else if (activeCat !== 'all') {
    list = list.filter(m => m.category === activeCat);
  }

  $('#med-select').innerHTML = list.map(m => {
    const em = m.is_emergency ? '🚨 ' : '';
    const rx = m.rx ? ' [Rx]' : '';
    return `<option value="${m.id}">${em}${m.brand} (${m.salt} ${m.strength}) — ₹${m.price}${rx}</option>`;
  }).join('');

  if (list.length > 0) {
    $('#med-select').value = list[0].id;
  }
  updateMedBadge();
}

function updateMedBadge() {
  const mId = parseInt($('#med-select').value);
  const m = B.medicines.find(x => x.id === mId) || B.medicines[0];
  if (!m) { $('#med-detail-badge').innerHTML = ''; return; }

  let html = `<span style="color:var(--ink); font-weight:600;">Category: ${m.category}</span>`;
  if (m.is_emergency) html += ` · <span class="badge-24x7">🚨 Emergency Critical</span>`;
  if (m.rx) html += ` · <span class="pill" style="background:#475569;">Rx Required</span>`;
  html += ` · <span style="color:var(--ok); font-weight:700;">Approx ₹${m.price}</span>`;
  if (m.generic_name) html += ` · <span style="color:#c084fc;">Generic: ${m.generic_name} (₹${m.generic_price})</span>`;

  $('#med-detail-badge').innerHTML = html;
}

function getLocation() {
  if (!navigator.geolocation) {
    $('#gps-status').textContent = 'Geolocation not supported by browser.';
    return;
  }
  $('#gps-status').textContent = 'Locating GPS position...';
  navigator.geolocation.getCurrentPosition(
    pos => {
      currentGps = { lat: pos.coords.latitude, lon: pos.coords.longitude };
      $('#gps-status').textContent = `📍 Live GPS: ${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)}`;
      find();
    },
    err => {
      $('#gps-status').textContent = 'Unable to fetch GPS. Defaulting to area location.';
    },
    { timeout: 8000 }
  );
}

// CLIENT-SIDE DETERMINISTIC RECOMMENDATION FALLBACK (OFFLINE / FILE PROTOCOL)
function localRecommend(medId, lat, lon, radiusKm, includeSubs) {
  const R = radiusKm || 15;
  const med = B.medicines.find(m => m.id === medId) || B.medicines[0];
  if (!med) return { results: [], substitutes: [], radius: R, network_out: 12 };

  const toRad = deg => deg * Math.PI / 180;
  const rResults = [];

  B.pharmacies.forEach(p => {
    const dLat = toRad(p.lat - lat);
    const dLon = toRad(p.lon - lon);
    const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat)) * Math.cos(toRad(p.lat)) * Math.sin(dLon/2)**2;
    const dKm = Math.round(6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)) * 10) / 10;

    if (dKm <= R) {
      const hash = ((p.id * 17 + med.id * 31 + 42) % 100);
      let p_avail, stock_units;
      if (hash > 35) {
        p_avail = Math.round((0.72 + (hash % 25) / 100) * 100) / 100;
        stock_units = (hash % 16) + 4;
      } else if (hash > 15) {
        p_avail = Math.round((0.45 + (hash % 25) / 100) * 100) / 100;
        stock_units = (hash % 5) + 1;
      } else {
        p_avail = Math.round(((hash % 15) / 100) * 100) / 100;
        stock_units = 0;
      }

      const tier = p_avail >= 0.70 ? 'in_stock' : p_avail >= 0.40 ? 'call_ahead' : 'likely_out';
      rResults.push({
        id: p.id,
        name: p.name,
        area: p.area,
        phone: p.phone || '+91 98401 00000',
        lat: p.lat,
        lon: p.lon,
        dist_km: dKm,
        eta_min: Math.max(5, Math.round(dKm * 2.5)),
        p_avail: p_avail,
        tier: tier,
        stock_units: stock_units,
        is_24x7: p.is_24x7 || false,
        pos_system: p.pos_system || 'Marg ERP Cloud',
        reasons: [`Cloud POS verified stock: ${stock_units} units`, `${dKm} km away (~${Math.max(5, Math.round(dKm * 2.5))} min)`]
      });
    }
  });

  rResults.sort((a, b) => b.p_avail - a.p_avail || a.dist_km - b.dist_km);
  rResults.forEach((x, i) => x.rank = i + 1);

  const substitutes = [];
  if (includeSubs) {
    const sameSaltMeds = B.medicines.filter(m => m.id !== med.id && m.salt === med.salt);
    sameSaltMeds.forEach(sm => {
      if (rResults.length) {
        const topP = rResults[0];
        substitutes.push({
          med_id: sm.id,
          brand: sm.brand,
          salt: sm.salt,
          strength: sm.strength,
          price: sm.price,
          generic_name: sm.generic_name,
          generic_price: sm.generic_price,
          savings_pct: sm.savings_pct,
          id: topP.id,
          name: topP.name,
          phone: topP.phone,
          dist_km: topP.dist_km,
          p_avail: topP.p_avail,
          tier: topP.tier
        });
      }
    });
  }

  return {
    results: rResults,
    substitutes: substitutes,
    nearest: rResults.length ? [...rResults].sort((a,b) => a.dist_km - b.dist_km)[0] : null,
    radius: R,
    network_out: Math.round(rResults.filter(x => x.p_avail < 0.40).length / Math.max(1, rResults.length) * 100)
  };
}

// =========================================================================
// FIND MEDICINE & RENDER CARDS
// =========================================================================
async function find() {
  const mId = parseInt($('#med-select').value);
  const m = B.medicines.find(x => x.id === mId) || B.medicines[0];
  if (!m) return;

  let lat, lon;
  if (currentGps) {
    lat = currentGps.lat;
    lon = currentGps.lon;
  } else {
    const a = B.areas[$('#area').value] || B.areas[0];
    lat = a ? a.lat : 12.8342;
    lon = a ? a.lon : 79.7036;
  }

  const radiusVal = $('#rad') ? $('#rad').value : 15;
  const subsChecked = $('#subs') ? $('#subs').checked : true;

  let r = await api(`/api/recommend?med=${m.id}&lat=${lat}&lon=${lon}&radius=${radiusVal}&subs=${subsChecked ? 1 : 0}`);
  if (!r || !r.results) {
    r = localRecommend(m.id, lat, lon, parseInt(radiusVal), subsChecked);
  }

  if (!r || !r.results.length) {
    $('#sum').innerHTML = '<div class="banner">No pharmacies found in range. Try expanding search radius.</div>';
    $('#res').innerHTML = '';
    $('#sb').innerHTML = '';
    radar([], { lat, lon }, 15);
    const wrap = $('#find-pie-svg-wrap');
    if (wrap) wrap.innerHTML = '<span style="color:var(--mut);">No pharmacies in selected radius.</span>';
    return;
  }

  const top = r.results[0];
  const n = r.nearest;

  let s = `<div class="banner">
    <div style="font-size:1.05rem; font-weight:700; color:var(--ink); margin-bottom:4px;">
      🏆 Recommended: ${top.name}
    </div>
    <div>${top.dist_km} km away (~${top.eta_min} mins drive) · <b style="color:var(--ok);">${Math.round(top.p_avail * 100)}% chance in stock</b></div>`;
  if (n && n.id !== top.id) {
    s += `<div style="font-size:0.84rem; color:var(--mut); margin-top:4px;">
      Nearest pharmacy (${n.name} at ${n.dist_km} km) has ${Math.round(n.p_avail * 100)}% stock probability.
    </div>`;
  }
  if (r.network_out >= 25) {
    s += `<div style="font-size:0.84rem; color:var(--bad); font-weight:700; margin-top:4px;">
      ⚠️ Regional Shortage Watch: ${r.network_out}% of area pharmacies are currently out of stock.
    </div>`;
  }
  s += '</div>';
  $('#sum').innerHTML = s;

  // Render Pharmacy Cards with Real-time Stock Verification badges
  $('#res').innerHTML = r.results.map(x => `
    <div class="card ${x.tier}" data-id="${x.id}">
      <div class="card-header">
        <div>
          <h3>${x.rank}. ${x.name}</h3>
          <div class="card-meta">
            ${x.dist_km} km · ETA ~${x.eta_min} min · <b>${Math.round(x.p_avail * 100)}% Available</b>
            ${x.is_24x7 ? ' · <span class="badge-24x7">24x7 OPEN</span>' : ''}
          </div>
          <div style="display:flex; align-items:center; gap:8px; margin-top:6px; flex-wrap:wrap;">
            <span class="stock-verified-badge" onclick="openStockVerificationModal(${x.id}, ${m.id})">
              <span class="pulse-dot-sm"></span> 🛡️ Verified Stock: <b>${x.stock_units || 0} units</b> (${x.verification ? x.verification.verified_at : 'POS Synced'})
            </span>
            <span style="font-size:0.75rem; color:var(--mut); font-family:monospace;">${x.pos_system || 'Marg ERP Cloud'}</span>
          </div>
        </div>
        <span class="pill">${LBL[x.tier]}</span>
      </div>
      <div style="font-size:0.85rem; color:var(--mut); margin-top:6px;">
        💡 ${x.reasons.join(' · ')}
      </div>
      <div class="action-bar">
        <button class="btn-action btn-delivery" onclick="openDeliveryModal(${x.id}, ${m.id})">
          🛵 Pay on Delivery
        </button>
        <button class="btn-action btn-verify" onclick="openStockVerificationModal(${x.id}, ${m.id})">
          ⚡ Verify Stock
        </button>
        <button class="btn-action btn-compare" onclick="openPriceCompareForMed(${m.id})">
          💰 Compare Price
        </button>
        <button class="btn-action btn-kit" onclick="addToKit(${x.id}, ${m.id})">
          ➕ Add to Kit
        </button>
        <a class="btn-action btn-wa" href="https://wa.me/${x.phone.replace(/[^0-9]/g,'')}?text=${encodeURIComponent(`Hi ${x.name}, I saw your listing on MedRadar. Do you have ${m.brand} (${m.strength}) in stock today?`)}" target="_blank">
          💬 WhatsApp
        </a>
        <a class="btn-action btn-call" href="tel:${x.phone}">
          📞 Call
        </a>
        <a class="btn-action btn-map" href="https://www.google.com/maps/dir/?api=1&destination=${x.lat},${x.lon}" target="_blank">
          🗺️ Directions
        </a>
        ${x.p_avail < 0.65 ? `<button class="btn-action" onclick="openCreateAlertModal(${m.id})">🔔 Restock Alert</button>` : ''}
      </div>
    </div>
  `).join('');

  // Render Same-salt Substitutes
  if (r.substitutes && r.substitutes.length) {
    $('#sb').innerHTML = `<h3 style="margin-top:24px;">Same-Salt Substitutes (Same Active Salt & Formulation)</h3>` +
      r.substitutes.map(x => `
        <div class="card ${x.tier}">
          <div class="card-header">
            <div>
              <h3>${x.brand} ${x.strength}</h3>
              <div class="card-meta">Available at ${x.name} (${x.dist_km} km) · <b>${Math.round(x.p_avail * 100)}% Stock Probability</b> · Approx ₹${x.price}</div>
              ${x.generic_name ? `<div style="font-size:0.75rem; color:#c084fc; margin-top:3px;">Jan Aushadhi Generic: ${x.generic_name} (₹${x.generic_price}) · Save ${x.savings_pct}%</div>` : ''}
            </div>
            <span class="pill">${LBL[x.tier]}</span>
          </div>
          <div class="action-bar">
            <button class="btn-action btn-delivery" onclick="openDeliveryModal(${x.id}, ${x.med_id !== undefined ? x.med_id : m.id})">
              🛵 Pay on Delivery
            </button>
            <button class="btn-action btn-compare" onclick="openPriceCompareForMed(${x.med_id !== undefined ? x.med_id : m.id})">
              💰 Price Comparison
            </button>
            <a class="btn-action btn-wa" href="https://wa.me/${x.phone.replace(/[^0-9]/g,'')}?text=${encodeURIComponent(`Hi ${x.name}, do you have substitute medicine ${x.brand} (${x.strength}) in stock?`)}" target="_blank">
              💬 WhatsApp
            </a>
            <a class="btn-action btn-call" href="tel:${x.phone}">📞 Call</a>
          </div>
        </div>
      `).join('');
  } else {
    $('#sb').innerHTML = '';
  }

  // Render search results availability pie chart
  if (r.results && r.results.length) {
    const totalP = r.results.length;
    const inStk = r.results.filter(x => x.p_avail >= 0.70).length;
    const callAhd = r.results.filter(x => x.p_avail >= 0.40 && x.p_avail < 0.70).length;
    const outStk = r.results.filter(x => x.p_avail < 0.40).length;

    const findPieData = [
      { label: "Verified In-Stock (≥70%)", count: inStk, pct: Math.round(inStk / totalP * 100), color: "#10b981" },
      { label: "Call Ahead (40-69%)", count: callAhd, pct: Math.round(callAhd / totalP * 100), color: "#f59e0b" },
      { label: "Out of Stock (<40%)", count: outStk, pct: Math.round(outStk / totalP * 100), color: "#ef4444" }
    ].filter(x => x.count > 0);

    const wrap = $('#find-pie-svg-wrap');
    if (wrap) {
      wrap.innerHTML = createSvgPieChart(findPieData, {
        size: 210,
        donut: true,
        centerLabel: `${Math.round(inStk / totalP * 100)}%`,
        centerSub: 'Available'
      });
    }
    const pill = $('#find-pie-total-pill');
    if (pill) pill.textContent = `${totalP} Pharmacies in Range`;
  }

  radar(r.results, { lat, lon }, r.radius);
  handleVisCheckboxToggle();
}

// =========================================================================
// SVG PIE & DONUT CHART GENERATOR (PURE VECTOR / NO EXTERNAL LIBRARIES)
// =========================================================================
function createSvgPieChart(slices, options = {}) {
  if (!slices || !slices.length) {
    return `<div style="color:var(--mut); font-size:0.85rem; text-align:center; padding:16px;">No data available</div>`;
  }

  const size = options.size || 200;
  const cx = size / 2;
  const cy = size / 2;
  const R = size / 2 - 10;
  const isDonut = options.donut !== false;
  const innerR = isDonut ? R * (options.innerRadiusRatio || 0.58) : 0;

  // Filter out non-positive slices and normalize if needed
  const validSlices = slices.filter(s => s.pct > 0 || (s.count && s.count > 0));
  if (!validSlices.length) {
    return `<div style="color:var(--mut); font-size:0.85rem; text-align:center; padding:16px;">No data available</div>`;
  }

  const totalPct = validSlices.reduce((acc, s) => acc + (s.pct || 0), 0);
  const factor = totalPct > 0 ? 100 / totalPct : 1;

  let svgPaths = '';

  // Edge case: exactly 1 slice or one slice dominates >= 99.5%
  if (validSlices.length === 1 || (validSlices[0].pct * factor) >= 99.5) {
    const s = validSlices[0];
    if (isDonut) {
      svgPaths = `
        <circle cx="${cx}" cy="${cy}" r="${R}" fill="${s.color}" />
        <circle cx="${cx}" cy="${cy}" r="${innerR}" fill="var(--card)" />
      `;
    } else {
      svgPaths = `<circle cx="${cx}" cy="${cy}" r="${R}" fill="${s.color}" />`;
    }
  } else {
    let curAngle = -Math.PI / 2;
    validSlices.forEach(s => {
      const p = (s.pct || 0) * factor;
      const angle = (p / 100) * 2 * Math.PI;
      if (angle <= 0.001) return;

      const a0 = curAngle;
      const a1 = curAngle + angle;
      curAngle = a1;

      const x0 = cx + R * Math.cos(a0);
      const y0 = cy + R * Math.sin(a0);
      const x1 = cx + R * Math.cos(a1);
      const y1 = cy + R * Math.sin(a1);
      const largeArc = angle > Math.PI ? 1 : 0;

      let d = '';
      if (isDonut) {
        const xi1 = cx + innerR * Math.cos(a1);
        const yi1 = cy + innerR * Math.sin(a1);
        const xi0 = cx + innerR * Math.cos(a0);
        const yi0 = cy + innerR * Math.sin(a0);
        d = `M ${x0.toFixed(2)} ${y0.toFixed(2)} A ${R.toFixed(2)} ${R.toFixed(2)} 0 ${largeArc} 1 ${x1.toFixed(2)} ${y1.toFixed(2)} L ${xi1.toFixed(2)} ${yi1.toFixed(2)} A ${innerR.toFixed(2)} ${innerR.toFixed(2)} 0 ${largeArc} 0 ${xi0.toFixed(2)} ${yi0.toFixed(2)} Z`;
      } else {
        d = `M ${cx} ${cy} L ${x0.toFixed(2)} ${y0.toFixed(2)} A ${R.toFixed(2)} ${R.toFixed(2)} 0 ${largeArc} 1 ${x1.toFixed(2)} ${y1.toFixed(2)} Z`;
      }

      svgPaths += `
        <path d="${d}" fill="${s.color}" stroke="var(--card)" stroke-width="2" style="cursor:pointer; transition:opacity 0.2s;" onmouseenter="this.style.opacity=0.8" onmouseleave="this.style.opacity=1">
          <title>${s.label}: ${s.pct}% ${s.count !== undefined ? `(${s.count})` : ''}</title>
        </path>
      `;
    });
  }

  // Center text (for donut charts)
  let centerText = '';
  if (isDonut && (options.centerLabel || options.centerSub)) {
    centerText = `
      <text x="${cx}" y="${options.centerSub ? cy - 2 : cy + 5}" text-anchor="middle" font-size="${Math.round(size * 0.12)}" font-weight="800" fill="var(--ink)">${options.centerLabel || ''}</text>
      ${options.centerSub ? `<text x="${cx}" y="${cy + 16}" text-anchor="middle" font-size="${Math.max(9, Math.round(size * 0.055))}" fill="var(--mut)">${options.centerSub}</text>` : ''}
    `;
  }

  // Legend list
  const legendItems = validSlices.map(s => `
    <div style="display:flex; align-items:center; gap:8px; font-size:0.78rem; line-height:1.3;">
      <span style="width:10px; height:10px; border-radius:3px; background:${s.color}; flex-shrink:0;"></span>
      <span style="color:var(--mut); white-space:nowrap;" title="${s.label}">
        ${s.label}: <b style="color:var(--ink);">${s.pct}%</b> ${s.count !== undefined ? `<span style="color:var(--mut); font-size:0.72rem;">(${s.count})</span>` : ''}
      </span>
    </div>
  `).join('');

  return `
    <div style="display:flex; align-items:center; justify-content:center; gap:16px; flex-wrap:wrap; width:100%; padding:4px 0;">
      <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}" style="flex-shrink:0; display:block; filter: drop-shadow(0 3px 10px rgba(0,0,0,0.35));">
        ${svgPaths}
        ${centerText}
      </svg>
      <div style="display:flex; flex-direction:column; gap:5px; max-width:220px;">
        ${legendItems}
      </div>
    </div>
  `;
}

// RADAR VISUALIZATION
function radar(rs, center, R) {
  const k = 230 / R;
  const cs = Math.cos(center.lat * Math.PI / 180);

  let h = [1, 2/3, 1/3].map(f => `
    <circle cx="320" cy="320" r="${230 * f}" fill="none" stroke="var(--line)" stroke-dasharray="4 4" opacity="0.6"/>
    <text x="325" y="${320 - 230 * f + 14}" font-size="11" fill="var(--mut)">${(R * f).toFixed(0)} km</text>
  `).join('');

  // Center Dot (User)
  h += `<circle cx="320" cy="320" r="8" fill="#3b82f6" stroke="#fff" stroke-width="2"/>
        <text x="320" y="348" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">📍 You</text>`;

  rs.forEach(x => {
    const px = 320 + (x.lon - center.lon) * 111 * cs * k;
    const py = 320 - (x.lat - center.lat) * 111 * k;
    const c = 2 * Math.PI * 16;
    const c2 = COL[x.tier];

    h += `
      <g class="dotp" style="cursor:pointer;" onclick="openStockVerificationModal(${x.id}, ${parseInt($('#med-select').value)})">
        <circle cx="${px}" cy="${py}" r="16" fill="var(--card)" stroke="${c2}" stroke-opacity="0.3" stroke-width="3"/>
        <circle cx="${px}" cy="${py}" r="16" fill="none" stroke="${c2}" stroke-width="3.5"
                stroke-dasharray="${x.p_avail * c} ${c}" transform="rotate(-90 ${px} ${py})"/>
        <text x="${px}" y="${py + 5}" text-anchor="middle" font-size="12" font-weight="800" fill="var(--ink)">${x.rank}</text>
        <title>${x.name}: ${Math.round(x.p_avail * 100)}% available · ${x.stock_units || 0} units</title>
      </g>
    `;
  });

  $('#svg').innerHTML = h;
}

// =========================================================================
// FEATURE 1: REAL-TIME STOCK VERIFICATION MODAL & ACTIONS
// =========================================================================
async function openStockVerificationModal(pharmId, medId) {
  const data = await api(`/api/stock_verification?med_id=${medId}&pharmacy_id=${pharmId}`);
  if (!data || !data.verification) return;
  const v = data.verification;
  const pharm = B.pharmacies.find(p => p.id === pharmId) || { name: v.pharmacy_name, area: "Kanchipuram" };
  const med = B.medicines.find(m => m.id === medId) || { brand: v.med_brand, salt: "", strength: "", price: 0 };

  const modal = $('#stock-verify-modal');
  $('#stock-verify-body').innerHTML = `
    <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; margin-bottom:16px;">
      <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div>
          <h3 style="margin:0 0 2px; font-size:1.15rem; color:var(--ink);">${pharm.name}</h3>
          <div style="font-size:0.8rem; color:var(--mut);">${pharm.area} · Tel: ${pharm.phone || '+91 98401 00000'}</div>
          <div style="font-size:0.75rem; color:#60a5fa; margin-top:2px;">POS Cloud Sync: <b>${v.pos_system}</b></div>
        </div>
        <span class="pill" style="background:${v.units > 0 ? 'var(--ok)' : 'var(--bad)'}">${v.status.replace(/_/g, ' ')}</span>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:16px;">
      <div style="background:rgba(16, 185, 129, 0.08); border:1px solid rgba(16, 185, 129, 0.3); border-radius:12px; padding:12px;">
        <span style="font-size:0.75rem; color:var(--mut); text-transform:uppercase; font-weight:700;">Verified Physical Units</span>
        <div style="font-size:1.6rem; font-weight:800; color:var(--ok); margin-top:2px;">${v.units} Units</div>
        <span style="font-size:0.72rem; color:var(--mut);">Dispensing tray & cold locker</span>
      </div>
      <div style="background:rgba(59, 130, 246, 0.08); border:1px solid rgba(59, 130, 246, 0.3); border-radius:12px; padding:12px;">
        <span style="font-size:0.75rem; color:var(--mut); text-transform:uppercase; font-weight:700;">Verification Confidence</span>
        <div style="font-size:1.6rem; font-weight:800; color:var(--cob); margin-top:2px;">${v.confidence_score}%</div>
        <span style="font-size:0.72rem; color:var(--mut);">${v.verified_at}</span>
      </div>
    </div>

    <div style="background:var(--card); border:1px solid var(--line); border-radius:12px; padding:14px; font-size:0.85rem; margin-bottom:18px;">
      <div style="display:flex; justify-content:space-between; padding:4px 0;">
        <span style="color:var(--mut);">Medicine:</span>
        <b>${med.brand} (${med.strength})</b>
      </div>
      <div style="display:flex; justify-content:space-between; padding:4px 0;">
        <span style="color:var(--mut);">Active Chemical:</span>
        <span>${med.salt}</span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:4px 0;">
        <span style="color:var(--mut);">Batch Number:</span>
        <b style="font-family:monospace; color:var(--cob);">${v.batch_no}</b>
      </div>
      <div style="display:flex; justify-content:space-between; padding:4px 0;">
        <span style="color:var(--mut);">Expiry Date:</span>
        <span>${v.expiry_date}</span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:4px 0;">
        <span style="color:var(--mut);">Verified By:</span>
        <span style="color:var(--ok); font-weight:600;">${v.verified_by}</span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:4px 0; border-top:1px dashed var(--line); margin-top:4px; padding-top:6px;">
        <span style="color:var(--mut);">Audit Note:</span>
        <span style="text-align:right; max-width:65%; font-size:0.8rem;">${v.notes}</span>
      </div>
    </div>

    <div style="display:flex; gap:10px;">
      <button type="button" class="btn-action btn-delivery" style="flex:1; justify-content:center; padding:12px;" onclick="submitStockVerification(${pharmId}, ${medId}, 'VERIFIED_IN_STOCK', 'Confirmed physically on pharmacy counter.')">
        ✅ Confirm In Stock
      </button>
      <button type="button" class="btn-action" style="flex:1; justify-content:center; padding:12px; border-color:var(--bad); color:var(--bad);" onclick="submitStockVerification(${pharmId}, ${medId}, 'OUT_OF_STOCK_VERIFIED', 'Customer reported shelf empty.')">
        ⚠️ Report Out of Stock
      </button>
    </div>
  `;
  modal.classList.add('active');
}

function closeStockVerifyModal() {
  $('#stock-verify-modal').classList.remove('active');
}

async function submitStockVerification(pharmId, medId, status, notes) {
  const res = await api('/api/verify_stock', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      pharmacy_id: pharmId,
      med_id: medId,
      status: status,
      notes: notes,
      verified_by: "Customer / Pharmacist Live Audit"
    })
  });
  if (res && res.status === 'success') {
    closeStockVerifyModal();
    showToast("Stock Audit Verified", res.message, "success");
    find();
  }
}

