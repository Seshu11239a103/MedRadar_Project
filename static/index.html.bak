function loadLocalOrders() {
  try {
    const raw = localStorage.getItem('medradar_orders_v2');
    if (raw) {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.length) return parsed;
    }
  } catch (e) {}
  return JSON.parse(JSON.stringify(SEED_DELIVERY_ORDERS));
}

function saveLocalOrders(orders) {
  try {
    localStorage.setItem('medradar_orders_v2', JSON.stringify(orders));
  } catch (e) {}
}

let localDeliveryOrders = loadLocalOrders();

async function getDeliveryOrders() {
  const data = await api('/api/orders');
  if (data && data.orders && data.orders.length) {
    const remote = data.orders;
    saveLocalOrders(remote);
    localDeliveryOrders = remote;
    return remote;
  }
  return localDeliveryOrders;
}

function openDeliveryModal(pharmId, medId) {
  currentDeliveryPharmId = pharmId;
  currentDeliveryMedId = medId;
  currentDeliveryQty = 1;
  currentDeliveryMethod = 'Cash on Delivery';

  const pharm = (B.pharmacies && B.pharmacies.find(p => p.id === pharmId)) || { name: "Pharmacy", area: "Kanchipuram", phone: "+91 94432 10101" };
  const med = (B.medicines && B.medicines.find(m => m.id === medId)) || { brand: "Medicine", strength: "", price: 0 };

  const pharmIdEl = $('#del-pharm-id');
  if (pharmIdEl) pharmIdEl.value = pharmId;
  const medIdEl = $('#del-med-id');
  if (medIdEl) medIdEl.value = medId;
  const qtyDisp = $('#del-qty-disp');
  if (qtyDisp) qtyDisp.textContent = '1';

  if ($('#del-name') && !$('#del-name').value) $('#del-name').value = 'Ramesh Kumar';
  if ($('#del-phone') && !$('#del-phone').value) $('#del-phone').value = '+91 98401 23456';
  if ($('#del-address') && !$('#del-address').value) $('#del-address').value = '14, Gandhi Road, Kanchipuram';

  const summary = $('#modal-pharm-med-summary');
  if (summary) {
    summary.innerHTML = `
      <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div>
          <b style="font-size:1.1rem; color:var(--ink);">${med.brand} (${med.strength})</b>
          <div style="font-size:0.8rem; color:var(--mut);">Dispensing Pharmacy: <b>${pharm.name}</b> (${pharm.area})</div>
        </div>
        <b style="font-size:1.2rem; color:var(--ok);">₹<span id="del-unit-price">${med.price}</span></b>
      </div>
    `;
  }

  selectPodMethod('Cash on Delivery');
  const formView = $('#modal-form-view');
  if (formView) formView.style.display = 'block';
  const succView = $('#modal-success-view');
  if (succView) succView.style.display = 'none';
  const modal = $('#del-modal');
  if (modal) modal.classList.add('active');
}

function fastFillContact(name, phone, address) {
  if ($('#del-name')) $('#del-name').value = name || 'Ramesh Kumar';
  if ($('#del-phone')) $('#del-phone').value = phone || '+91 98401 23456';
  if ($('#del-address')) $('#del-address').value = address || '14, Gandhi Road, Kanchipuram';
}

function closeDeliveryModal() {
  $('#del-modal').classList.remove('active');
}

function selectPodMethod(method) {
  currentDeliveryMethod = method;
  const radio = document.querySelector(`input[name="pod-method"][value="${method}"]`);
  if (radio) radio.checked = true;

  document.querySelectorAll('.pod-option-card').forEach(el => {
    el.classList.remove('active');
    el.style.borderColor = 'var(--line)';
    el.style.background = 'var(--panel)';
  });

  const cardId = method === 'Doorstep UPI' ? 'pod-card-upi' : (method === 'Card on Delivery' ? 'pod-card-card' : 'pod-card-cash');
  const activeCard = $(`#${cardId}`);
  if (activeCard) {
    activeCard.classList.add('active');
    activeCard.style.borderColor = 'var(--ok)';
    activeCard.style.background = 'rgba(16, 185, 129, 0.08)';
  }
  updateDeliveryPriceBreakdown();
}

function changeDeliveryQty(delta) {
  currentDeliveryQty = Math.max(1, Math.min(10, currentDeliveryQty + delta));
  $('#del-qty-disp').textContent = currentDeliveryQty;
  updateDeliveryPriceBreakdown();
}

function updateDeliveryPriceBreakdown() {
  const med = (B.medicines && B.medicines.find(m => m.id === currentDeliveryMedId)) || { price: 0 };
  const subtotal = (med.price || 0) * currentDeliveryQty;
  const delFee = subtotal >= 250 ? 0 : 35;
  const total = subtotal + delFee;
  const amtSpan = $('#del-btn-amt');
  if (amtSpan) {
    amtSpan.textContent = total;
  }
  const submitBtn = $('#btn-submit-del');
  if (submitBtn) {
    submitBtn.innerHTML = `🛵 Confirm Pay on Delivery Order · ₹<span id="del-btn-amt">${total}</span> (${currentDeliveryMethod})`;
  }
}

async function submitDeliveryOrder(e) {
  if (e && e.preventDefault) e.preventDefault();
  const nameInput = $('#del-name');
  const phoneInput = $('#del-phone');
  const addressInput = $('#del-address');

  const name = (nameInput && nameInput.value ? nameInput.value.trim() : '') || 'Ramesh Kumar';
  const phone = (phoneInput && phoneInput.value ? phoneInput.value.trim() : '') || '+91 98401 23456';
  const address = (addressInput && addressInput.value ? addressInput.value.trim() : '') || '14, Gandhi Road, Kanchipuram';
  const checkedRadio = document.querySelector('input[name="pod-method"]:checked');
  const method = checkedRadio ? checkedRadio.value : currentDeliveryMethod;

  const submitBtn = $('#btn-submit-del');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.innerHTML = `⏳ Processing Pharmaceutical Order...`;
  }

  const pharm = B.pharmacies.find(p => p.id === currentDeliveryPharmId) || { name: "Kanchipuram Pharmacy", area: "Gandhi Road", phone: "+91 94432 10101" };
  const med = B.medicines.find(m => m.id === currentDeliveryMedId) || { brand: "Medicine", salt: "General Rx", strength: "Standard", price: 100, rx: false };

  const subtotal = med.price * currentDeliveryQty;
  const delivery_fee = subtotal >= 250 ? 0 : 35;
  const total = subtotal + delivery_fee;

  let order = null;
  try {
    const res = await api('/api/order_delivery', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        pharmacy_id: currentDeliveryPharmId,
        med_id: currentDeliveryMedId,
        customer_name: name,
        phone: phone,
        address: address,
        payment_method: method,
        quantity: currentDeliveryQty
      })
    });
    if (res && res.status === 'success' && res.order) {
      order = res.order;
    }
  } catch (err) {
    console.warn("Server order delivery error, using resilient fallback:", err);
  }

  if (!order) {
    const orderId = `MR-DEL-${Math.floor(100000 + Math.random() * 900000)}`;
    order = {
      id: orderId,
      created_at: "Just now",
      customer_name: name,
      phone: phone,
      address: address,
      pharmacy_id: currentDeliveryPharmId,
      pharmacy_name: pharm.name,
      pharmacy_phone: pharm.phone || "+91 94432 10101",
      pharmacy_area: pharm.area,
      pharmacy_dl: `TN-KC-2024-${(currentDeliveryPharmId * 137 + 1042) % 9000 + 1000}`,
      pharmacy_gstin: `33AAACP${(currentDeliveryPharmId * 419 + 1102) % 9000 + 1000}Q1Z5`,
      med_id: currentDeliveryMedId,
      med_brand: med.brand,
      med_salt: med.salt,
      med_strength: med.strength,
      batch_no: `KC26-${(currentDeliveryMedId * 73 + 105) % 900 + 100}`,
      expiry_date: "12/2028",
      quantity: currentDeliveryQty,
      unit_price: med.price,
      subtotal: subtotal,
      delivery_fee: delivery_fee,
      total: total,
      payment_method: method,
      payment_status: "Pending (Pay on Delivery)",
      order_status: "Order Placed & Confirmed",
      status_step: 0,
      eta_mins: 35,
      rider_name: "Murugan K.",
      rider_phone: "+91 98401 23456",
      rider_vehicle: "Hero Splendor (TN-21-AX-4821)",
      delivery_otp: `${Math.floor(1000 + Math.random() * 9000)}`,
      rx_required: med.rx,
      prescription: null,
      notes: ""
    };
  }

  localDeliveryOrders.unshift(order);
  saveLocalOrders(localDeliveryOrders);

  if (submitBtn) {
    submitBtn.disabled = false;
    submitBtn.innerHTML = `🛵 Confirm Pay on Delivery Order · ₹<span id="del-btn-amt">${total}</span> (${method})`;
  }

  $('#modal-form-view').style.display = 'none';
  $('#modal-success-view').style.display = 'block';
  $('#succ-details').innerHTML = `
    <div style="display:flex; justify-content:space-between; padding:3px 0;"><span>Order ID:</span><b style="color:var(--cob); font-family:monospace;">${order.id}</b></div>
    <div style="display:flex; justify-content:space-between; padding:3px 0;"><span>Medicine:</span><b>${order.med_brand} (${order.med_strength}) × ${order.quantity}</b></div>
    <div style="display:flex; justify-content:space-between; padding:3px 0;"><span>Pharmacy:</span><span>${order.pharmacy_name}</span></div>
    <div style="display:flex; justify-content:space-between; padding:3px 0;"><span>Rider OTP:</span><b style="color:var(--ok); font-size:1.1rem; font-family:monospace;">${order.delivery_otp}</b></div>
    <div style="display:flex; justify-content:space-between; padding:3px 0; border-top:1px dashed var(--line); margin-top:6px; padding-top:6px; font-size:1rem;"><span>Collect at Doorstep:</span><b style="color:var(--ok);">₹${order.total} (${order.payment_method})</b></div>
  `;

  const btnUpi = $('#succ-btn-upi');
  if (btnUpi) btnUpi.onclick = () => openUpiModal(order.id);
  const btnInv = $('#succ-btn-inv');
  if (btnInv) btnInv.onclick = () => openInvoiceModal(order.id);

  updateOrdersBadge(localDeliveryOrders.length);
  showToast("Order Processed", `Pharmaceutical Order ${order.id} confirmed with ${order.payment_method}!`, "success");
}

async function placeRestockPodOrder(pharmId, medId, qty = 25) {
  const pharm = (B.pharmacies && B.pharmacies.find(p => p.id === pharmId)) || (B.pharmacies && B.pharmacies[0]) || { name: "Pharmacy", area: "Kanchipuram", phone: "+91 94432 10101" };
  const med = (B.medicines && B.medicines.find(m => m.id === medId)) || (B.medicines && B.medicines[0]) || { brand: "Medicine", price: 50 };

  showToast("Processing Order", `Placing pharmaceutical distributor restock order for ${qty} units of ${med.brand} (Pay on Delivery)...`, "info");

  let order = null;
  try {
    const res = await api('/api/order_delivery', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        pharmacy_id: pharmId,
        med_id: medId,
        customer_name: `${pharm.name} (Pharmacy Store Manager)`,
        phone: pharm.phone || "+91 94432 10101",
        address: `${pharm.name}, ${pharm.area}, Kanchipuram`,
        payment_method: "Cash on Delivery",
        quantity: Math.min(10, qty),
        notes: "Pharmaceutical Distributor Replenishment Order (Pay on Delivery)"
      })
    });
    if (res && res.status === 'success' && res.order) {
      order = res.order;
    }
  } catch (e) {}

  if (!order) {
    order = {
      id: `MR-RESTOCK-${Math.floor(100000 + Math.random() * 900000)}`,
      created_at: "Just now",
      customer_name: `${pharm.name} (Store Manager)`,
      phone: pharm.phone || "+91 94432 10101",
      address: `${pharm.name}, ${pharm.area}`,
      pharmacy_id: pharmId,
      pharmacy_name: pharm.name,
      pharmacy_phone: pharm.phone,
      pharmacy_area: pharm.area,
      pharmacy_dl: `TN-KC-2024-${(pharmId * 137 + 1042) % 9000 + 1000}`,
      pharmacy_gstin: `33AAACP${(pharmId * 419 + 1102) % 9000 + 1000}Q1Z5`,
      med_id: medId,
      med_brand: med.brand,
      med_salt: med.salt,
      med_strength: med.strength,
      batch_no: `KC26-${(medId * 73 + 105) % 900 + 100}`,
      expiry_date: "12/2028",
      quantity: Math.min(10, qty),
      unit_price: med.price,
      subtotal: med.price * Math.min(10, qty),
      delivery_fee: 0,
      total: med.price * Math.min(10, qty),
      payment_method: "Cash on Delivery",
      payment_status: "Pending (Pay on Delivery)",
      order_status: "Order Placed & Confirmed",
      status_step: 0,
      eta_mins: 45,
      rider_name: "Distributor Express Logistics",
      rider_phone: "+91 98401 99999",
      rider_vehicle: "Tata Ace Delivery Van",
      delivery_otp: `${Math.floor(1000 + Math.random() * 9000)}`,
      rx_required: false,
      prescription: null,
      notes: "Distributor Restock"
    };
  }

  localDeliveryOrders.unshift(order);
  saveLocalOrders(localDeliveryOrders);
  updateOrdersBadge(localDeliveryOrders.length);

  showToast("Restock Order Processed", `Pharmaceutical Restock Order ${order.id} placed with Pay on Delivery!`, "success", 4000);
  stock();
}

function generateUpiQrSvg(text, size = 200) {
  const N = 25;
  const grid = [];
  for (let r = 0; r < N; r++) {
    grid.push(new Array(N).fill(0));
  }

  function drawFinder(r0, c0) {
    for (let r = 0; r < 7; r++) {
      for (let c = 0; c < 7; c++) {
        const isBorder = (r === 0 || r === 6 || c === 0 || c === 6);
        const isCenter = (r >= 2 && r <= 4 && c >= 2 && c <= 4);
        grid[r0 + r][c0 + c] = (isBorder || isCenter) ? 1 : 0;
      }
    }
  }

  drawFinder(0, 0);
  drawFinder(0, N - 7);
  drawFinder(N - 7, 0);

  for (let i = 8; i < N - 8; i++) {
    grid[6][i] = (i % 2 === 0) ? 1 : 0;
    grid[i][6] = (i % 2 === 0) ? 1 : 0;
  }

  for (let r = 16; r <= 20; r++) {
    for (let c = 16; c <= 20; c++) {
      const isAlignBorder = (r === 16 || r === 20 || c === 16 || c === 20);
      const isAlignCenter = (r === 18 && c === 18);
      grid[r][c] = (isAlignBorder || isAlignCenter) ? 1 : 0;
    }
  }

  let hash = 0;
  for (let i = 0; i < text.length; i++) {
    hash = ((hash << 5) - hash + text.charCodeAt(i)) & 0xffffffff;
  }
  let seed = Math.abs(hash) || 987654321;
  function rnd() {
    seed = (seed * 1664525 + 1013904223) & 0xffffffff;
    return (seed >>> 0) / 4294967296;
  }

  for (let r = 0; r < N; r++) {
    for (let c = 0; c < N; c++) {
      if ((r <= 7 && c <= 7) || (r <= 7 && c >= N - 8) || (r >= N - 8 && c <= 7)) continue;
      if (r === 6 || c === 6) continue;
      if (r >= 16 && r <= 20 && c >= 16 && c <= 20) continue;
      grid[r][c] = rnd() > 0.48 ? 1 : 0;
    }
  }

  const cellSize = (size - 24) / N;
  const pad = 12;
  let rects = '';
  for (let r = 0; r < N; r++) {
    for (let c = 0; c < N; c++) {
      if (grid[r][c]) {
        const x = (pad + c * cellSize).toFixed(1);
        const y = (pad + r * cellSize).toFixed(1);
        const s = cellSize.toFixed(1);
        rects += `<rect x="${x}" y="${y}" width="${s}" height="${s}" fill="#0f172a" />`;
      }
    }
  }

  const centerBadge = `
    <rect x="${(size/2 - 18).toFixed(1)}" y="${(size/2 - 18).toFixed(1)}" width="36" height="36" rx="8" fill="#ffffff" stroke="#0ea5e9" stroke-width="2" />
    <text x="${(size/2).toFixed(1)}" y="${(size/2 + 5).toFixed(1)}" font-family="system-ui, sans-serif" font-weight="900" font-size="13" fill="#0ea5e9" text-anchor="middle">UPI</text>
  `;

  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${size} ${size}" width="${size}" height="${size}" style="background:#ffffff; border-radius:12px; display:block; margin:0 auto; box-shadow:0 4px 14px rgba(0,0,0,0.12);">` +
    `<rect width="100%" height="100%" fill="#ffffff" rx="12" />` +
    rects +
    centerBadge +
    `</svg>`;
}

async function openUpiModal(orderId) {
  const orders = await getDeliveryOrders();
  const o = orders.find(x => x.id === orderId) || orders[0];
  if (!o) return;
  window.__currentUpiOrder = o;
  window.__activePaymentOrder = o;

  $('#upi-amt-disp').textContent = o.total;
  $('#upi-vpa-disp').textContent = 'medradar.pay@upi';

  const upiUrl = `upi://pay?pa=medradar.pay@upi&pn=MedRadar%20Kanchipuram&am=${o.total}&cu=INR&tn=Order%20${o.id}`;
  const upiLink = $('#upi-intent-link');
  if (upiLink) upiLink.href = upiUrl;

  const qrWrap = $('#upi-qr-svg-wrap');
  if (qrWrap) {
    qrWrap.innerHTML = generateUpiQrSvg(upiUrl, 200);
    qrWrap.style.display = 'block';
  }

  const qrImg = $('#upi-qr-img');
  if (qrImg) {
    qrImg.style.display = 'none';
    qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(upiUrl)}`;
    qrImg.onload = () => {
      qrImg.style.display = 'block';
      if (qrWrap) qrWrap.style.display = 'none';
    };
    qrImg.onerror = () => {
      qrImg.style.display = 'none';
      if (qrWrap) qrWrap.style.display = 'block';
    };
  }

  $('#upi-modal').classList.add('active');
}

function closeUpiModal() {
  $('#upi-modal').classList.remove('active');
}

function copyUpiId() {
  if (navigator.clipboard) {
    navigator.clipboard.writeText('medradar.pay@upi');
  }
  showToast("Copied", "UPI ID medradar.pay@upi copied to clipboard!", "success", 2500);
}

async function markPaidCurrentUpi() {
  if (!window.__currentUpiOrder) return;
  const o = window.__currentUpiOrder;
  await settleOrderPayment(o.id, 'Doorstep UPI');
  closeUpiModal();
}

async function openCashModal(orderId) {
  const orders = await getDeliveryOrders();
  const o = orders.find(x => x.id === orderId) || orders[0];
  if (!o) return;
  window.__currentCashOrder = o;
  window.__activePaymentOrder = o;

  $('#cash-amt-due').textContent = o.total;
  $('#cash-order-info').textContent = `${o.med_brand} (${o.med_strength}) × ${o.quantity} · Pharmacy: ${o.pharmacy_name}`;

  const input = $('#cash-tendered-input');
  if (input) {
    input.value = o.total;
  }
  calculateCashChange();
  $('#cash-modal').classList.add('active');
}

function closeCashModal() {
  $('#cash-modal').classList.remove('active');
}

function calculateCashChange() {
  if (!window.__currentCashOrder) return;
  const due = window.__currentCashOrder.total;
  const input = $('#cash-tendered-input');
  const tendered = parseFloat(input ? input.value : 0) || 0;
  const change = tendered - due;
  const changeDisp = $('#cash-change-disp');
  const statusNote = $('#cash-status-note');

  if (change < 0) {
    if (changeDisp) changeDisp.textContent = `₹0`;
    if (statusNote) {
      statusNote.textContent = `Short by ₹${Math.abs(change)}`;
      statusNote.style.color = 'var(--bad)';
    }
  } else {
    if (changeDisp) changeDisp.textContent = `₹${change}`;
    if (statusNote) {
      statusNote.textContent = change === 0 ? 'Exact Amount Given' : `Return ₹${change} Change`;
      statusNote.style.color = 'var(--ok)';
    }
  }
}

function setTenderedAmount(amt) {
  if (!window.__currentCashOrder) return;
  const input = $('#cash-tendered-input');
  if (!input) return;
  if (amt === 'exact') {
    input.value = window.__currentCashOrder.total;
  } else {
    input.value = amt;
  }
  calculateCashChange();
}

async function confirmCashPayment() {
  if (!window.__currentCashOrder) return;
  const o = window.__currentCashOrder;
  await settleOrderPayment(o.id, 'Cash on Delivery');
  closeCashModal();
}

function switchToCashFromUpi() {
  closeUpiModal();
  if (window.__currentUpiOrder) {
    openCashModal(window.__currentUpiOrder.id);
  }
}

function switchToUpiFromCash() {
  closeCashModal();
  if (window.__currentCashOrder) {
    openUpiModal(window.__currentCashOrder.id);
  }
}

async function settleCurrentWithCard() {
  const o = window.__currentUpiOrder || window.__currentCashOrder || window.__activePaymentOrder;
  if (!o) return;
  closeUpiModal();
  closeCashModal();
  await settleOrderPayment(o.id, 'Card on Delivery');
}

async function settleOrderPayment(orderId, method) {
  await api('/api/order_payment', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      order_id: orderId,
      payment_method: method,
      payment_status: `Paid via ${method}`
    })
  });

  const idx = localDeliveryOrders.findIndex(o => o.id === orderId);
  if (idx !== -1) {
    localDeliveryOrders[idx].payment_method = method;
    localDeliveryOrders[idx].payment_status = `Paid via ${method}`;
    localDeliveryOrders[idx].status_step = 3;
    localDeliveryOrders[idx].order_status = "Delivered to Doorstep & Settled";
    localDeliveryOrders[idx].eta_mins = 0;
    saveLocalOrders(localDeliveryOrders);
  }

  showToast("Payment Settled", `Order ${orderId} marked paid via ${method} at doorstep!`, "success", 4000);
  renderOrdersPage();
}

async function switchPaymentMethod(orderId, newMethod) {
  if (!newMethod) return;
  const idx = localDeliveryOrders.findIndex(o => o.id === orderId);
  if (idx !== -1) {
    localDeliveryOrders[idx].payment_method = newMethod;
    saveLocalOrders(localDeliveryOrders);
  }
  await api('/api/order_status', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      order_id: orderId,
      payment_method: newMethod
    })
  });
  showToast("Payment Method Updated", `Order ${orderId} switched to ${newMethod}`, "info");

  if (newMethod === 'Doorstep UPI') {
    openUpiModal(orderId);
  } else if (newMethod === 'Cash on Delivery') {
    openCashModal(orderId);
  } else if (newMethod === 'Card on Delivery') {
    settleOrderPayment(orderId, 'Card on Delivery');
  } else {
    renderOrdersPage();
  }
}

function filterDeliveryOrders(filter) {
  currentOrdersFilter = filter;
  document.querySelectorAll('#v-orders .chip').forEach(c => c.classList.remove('active'));
  const activeBtn = $(`#order-filter-${filter}`);
  if (activeBtn) activeBtn.classList.add('active');
  renderOrdersPage();
}

async function renderOrdersPage() {
  const orders = await getDeliveryOrders();
  updateOrdersBadge(orders.length);

  const pendingCount = orders.filter(o => !o.payment_status || !o.payment_status.toLowerCase().includes('paid')).length;
  const settledCount = orders.filter(o => o.payment_status && o.payment_status.toLowerCase().includes('paid')).length;

  if ($('#filter-cnt-all')) $('#filter-cnt-all').textContent = orders.length;
  if ($('#filter-cnt-pending')) $('#filter-cnt-pending').textContent = pendingCount;
  if ($('#filter-cnt-settled')) $('#filter-cnt-settled').textContent = settledCount;

  let displayOrders = orders;
  if (currentOrdersFilter === 'pending') {
    displayOrders = orders.filter(o => !o.payment_status || !o.payment_status.toLowerCase().includes('paid'));
  } else if (currentOrdersFilter === 'settled') {
    displayOrders = orders.filter(o => o.payment_status && o.payment_status.toLowerCase().includes('paid'));
  } else if (currentOrdersFilter === 'upi') {
    displayOrders = orders.filter(o => (o.payment_method || '').toLowerCase().includes('upi'));
  } else if (currentOrdersFilter === 'cash') {
    displayOrders = orders.filter(o => (o.payment_method || '').toLowerCase().includes('cash'));
  }

  if (!displayOrders.length) {
    $('#orders-container').innerHTML = `
      <div class="control-panel" style="text-align:center; padding:40px 20px;">
        <span style="font-size:2.5rem;">🛵</span>
        <h3 style="margin:12px 0 6px;">No Orders Matching Filter</h3>
        <p style="color:var(--mut); margin:0 0 16px;">Try switching filters or place a new Pay on Delivery order.</p>
        <button class="btn-action btn-delivery" onclick="filterDeliveryOrders('all'); switchTab('find')">🔍 Find Medicine to Order</button>
      </div>
    `;
    return;
  }

  $('#orders-container').innerHTML = displayOrders.map(o => {
    const isPaid = o.payment_status && o.payment_status.toLowerCase().includes('paid');
    const step = o.status_step !== undefined ? o.status_step : (isPaid ? 3 : 1);

    let methodBadge = '';
    if ((o.payment_method || '').toLowerCase().includes('upi')) {
      methodBadge = `<span class="pill" style="background:rgba(14,165,233,0.15); color:#38bdf8; border:1px solid rgba(14,165,233,0.4);">📲 ${o.payment_method}</span>`;
    } else if ((o.payment_method || '').toLowerCase().includes('card')) {
      methodBadge = `<span class="pill" style="background:rgba(168,85,247,0.15); color:#c084fc; border:1px solid rgba(168,85,247,0.4);">💳 ${o.payment_method}</span>`;
    } else {
      methodBadge = `<span class="pill" style="background:rgba(234,179,8,0.15); color:#fbbf24; border:1px solid rgba(234,179,8,0.4);">💵 ${o.payment_method || 'Cash on Delivery'}</span>`;
    }

    const payStatusBadge = isPaid
      ? `<span class="pill" style="background:var(--ok); color:#fff; font-weight:700;">✅ ${o.payment_status}</span>`
      : `<span class="pill" style="background:rgba(234,179,8,0.2); color:#fbbf24; border:1px solid rgba(234,179,8,0.5); font-weight:700;">⏳ Payment Pending · Collect ₹${o.total}</span>`;

    const stepNames = ["Placed", "Packed", "Dispatched", "Delivered & Settled"];
    const stepIndicators = stepNames.map((sName, sIdx) => {
      const active = sIdx <= step;
      const current = sIdx === step;
      return `
        <div style="flex:1; text-align:center;">
          <div style="height:4px; border-radius:2px; background:${active ? 'var(--ok)' : 'var(--line)'}; margin-bottom:4px;"></div>
          <span style="font-size:0.68rem; color:${current ? 'var(--ok)' : (active ? 'var(--ink)' : 'var(--mut)')}; font-weight:${active ? '700' : '400'};">${sName}</span>
        </div>
      `;
    }).join('');

    return `
      <div class="card" style="border-left:6px solid ${isPaid ? 'var(--ok)' : 'var(--warn)'}; margin-bottom:16px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
          <div>
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px;">
              <b style="font-size:1.15rem; color:var(--ink);">${o.med_brand} (${o.med_strength}) × ${o.quantity}</b>
              ${methodBadge}
              ${payStatusBadge}
            </div>
            <div style="font-size:0.8rem; color:var(--mut);">
              Order ID: <b style="font-family:monospace; color:var(--cob);">${o.id}</b> · ${o.created_at}
            </div>
            <div style="font-size:0.82rem; color:var(--mut); margin-top:3px;">
              Dispensing Pharmacy: <b style="color:var(--ink);">${o.pharmacy_name}</b> (${o.pharmacy_area})
            </div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:1.35rem; font-weight:900; color:var(--ok);">₹${o.total}</div>
            <span class="pill" style="background:${isPaid ? 'var(--ok)' : 'var(--cob)'}; font-size:0.75rem;">${o.order_status}</span>
          </div>
        </div>

        <div style="display:flex; gap:6px; margin:14px 0 10px; background:rgba(0,0,0,0.15); padding:8px 12px; border-radius:10px;">
          ${stepIndicators}
        </div>

        <div style="background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:10px 14px; margin:10px 0; font-size:0.82rem; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px;">
          <div>Rider: <b>${o.rider_name || 'Murugan K.'}</b> (${o.rider_phone || '+91 98401 23456'})</div>
          <div>Delivery OTP: <b style="color:var(--ok); font-size:0.95rem; font-family:monospace;">${o.delivery_otp}</b></div>
          <div>Address: <span style="color:var(--ink); font-weight:600;">${o.address}</span></div>
        </div>

        ${!isPaid ? `
          <div style="background:rgba(234,179,8,0.06); border:1px solid rgba(234,179,8,0.25); border-radius:12px; padding:12px 14px; margin:12px 0;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:8px;">
              <span style="font-size:0.82rem; font-weight:700; color:#fbbf24;">
                💳 Doorstep Payment Collection: ₹${o.total} (${o.payment_method})
              </span>
              <span style="font-size:0.75rem; color:var(--mut);">Select collection method below to settle</span>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
              <button class="btn-action" style="background:linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%); color:#fff; border:0; font-weight:700;" onclick="openUpiModal('${o.id}')">
                📲 Doorstep UPI QR
              </button>
              <button class="btn-action" style="background:linear-gradient(135deg, #10b981 0%, #059669 100%); color:#fff; border:0; font-weight:700;" onclick="openCashModal('${o.id}')">
                💵 Pay with Cash
              </button>
              <button class="btn-action" style="background:rgba(168,85,247,0.2); color:#c084fc; border:1px solid rgba(168,85,247,0.4); font-weight:700;" onclick="settleOrderPayment('${o.id}', 'Card on Delivery')">
                💳 Pay with Card
              </button>
              <select onchange="switchPaymentMethod('${o.id}', this.value)" style="padding:6px 10px; font-size:0.78rem; border-radius:8px; border:1px solid var(--line); background:var(--card); color:var(--ink);">
                <option value="" disabled selected>🔄 Switch Method...</option>
                <option value="Doorstep UPI">📲 Switch to UPI QR</option>
                <option value="Cash on Delivery">💵 Switch to Cash</option>
                <option value="Card on Delivery">💳 Switch to Card mPOS</option>
              </select>
            </div>
          </div>
        ` : `
          <div style="background:rgba(16,185,129,0.08); border:1px solid rgba(16,185,129,0.3); border-radius:10px; padding:10px 14px; margin:10px 0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
            <div style="font-size:0.82rem; color:var(--ok); font-weight:700;">
              ✅ Payment Complete: Settled via ${o.payment_method} · No Balance Due
            </div>
            <button class="chip" style="font-size:0.72rem; padding:3px 8px;" onclick="switchPaymentMethod('${o.id}', '${(o.payment_method||'').includes('Cash') ? 'Doorstep UPI' : 'Cash on Delivery'}')">
              🔄 Switch / Reopen Payment
            </button>
          </div>
        `}

        <div class="action-bar" style="margin-top:8px;">
          <button class="btn-action" onclick="openInvoiceModal('${o.id}')">🧾 Tax Invoice & Receipt</button>
          <button class="btn-action" onclick="advanceOrderStatus('${o.id}')">🚚 Advance Status</button>
        </div>
      </div>
    `;
  }).join('');
}

async function openInvoiceModal(orderId) {
  const orders = await getDeliveryOrders();
  const o = orders.find(x => x.id === orderId) || orders[0];
  if (!o) return;

  $('#inv-pharm-name').textContent = o.pharmacy_name;
  $('#inv-pharm-meta').textContent = `${o.pharmacy_area}, Kanchipuram, Tamil Nadu · Tel: ${o.pharmacy_phone || '+91 94432 12345'}`;
  $('#inv-dl-no').textContent = o.pharmacy_dl || 'TN-KC-2024-4821';
  $('#inv-gstin').textContent = o.pharmacy_gstin || '33AAACP4821Q1Z5';
  $('#inv-no').textContent = `#INV-${o.id.replace('MR-DEL-', '')}`;
  $('#inv-date').textContent = o.created_at;
  $('#inv-cust-name').textContent = o.customer_name;
  $('#inv-cust-addr').textContent = o.address;
  $('#inv-cust-phone').textContent = o.phone;
  $('#inv-order-id').textContent = o.id;
  $('#inv-pay-mode').textContent = o.payment_method;
  $('#inv-pay-status').textContent = o.payment_status || 'Doorstep Settlement';

  $('#inv-items-body').innerHTML = `
    <tr>
      <td>1</td>
      <td><b>${o.med_brand}</b> (${o.med_salt} ${o.med_strength})</td>
      <td style="font-family:monospace;">${o.batch_no || 'KC26-481'}</td>
      <td>${o.expiry_date || '06/2028'}</td>
      <td><b>${o.quantity}</b></td>
      <td>₹${o.unit_price}</td>
      <td style="text-align:right;"><b>₹${o.subtotal}</b></td>
    </tr>
  `;

  $('#inv-subtotal').textContent = o.subtotal;
  $('#inv-del-fee').textContent = o.delivery_fee ? `₹${o.delivery_fee}` : 'FREE';
  $('#inv-grand-total').textContent = o.total;

  $('#invoice-modal').classList.add('active');
}

function closeInvoiceModal() {
  $('#invoice-modal').classList.remove('active');
}

async function advanceOrderStatus(orderId) {
  let updatedOrder = null;
  const res = await api('/api/order_status', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ order_id: orderId })
  });
  if (res && res.status === 'success') {
    updatedOrder = res.order;
  }

  const idx = localDeliveryOrders.findIndex(o => o.id === orderId);
  if (idx !== -1) {
    if (updatedOrder) {
      localDeliveryOrders[idx] = updatedOrder;
    } else {
      const nextStep = (localDeliveryOrders[idx].status_step + 1) % 4;
      const statusLabels = [
        "Order Placed & Confirmed",
        "Packed & Prescriptions Verified",
        "Rider Dispatched & En Route",
        "Delivered to Doorstep & Settled"
      ];
      localDeliveryOrders[idx].status_step = nextStep;
      localDeliveryOrders[idx].order_status = statusLabels[nextStep];
      if (nextStep === 3) {
        localDeliveryOrders[idx].payment_status = `Paid via ${localDeliveryOrders[idx].payment_method}`;
      }
    }
    saveLocalOrders(localDeliveryOrders);
  }

  showToast("Status Updated", `Order ${orderId} status advanced!`, "info");
  renderOrdersPage();
}

function viewRxLightbox(src) {
  $('#rx-lightbox-img').src = src;
  $('#rx-lightbox-modal').classList.add('active');
}

function closeRxLightbox() {
  $('#rx-lightbox-modal').classList.remove('active');
}

async function updateOrdersBadge(count) {
  const badge = $('#orders-badge');
  if (count === undefined) {
    const orders = await getDeliveryOrders();
    count = orders.length;
  }
  if (badge) {
    badge.textContent = count;
    badge.style.display = count > 0 ? 'inline-block' : 'none';
  }
}

// RESTOCK DESK
async function stock() {
  const pId = parseInt($('#ph') ? $('#ph').value : 0) || 0;
  let data = await api(`/api/restock?pharmacy=${pId}`);
  if (!data) data = localRestockDesk(pId);

  const pharmName = (data && data.pharmacy) ? (typeof data.pharmacy === 'string' ? data.pharmacy : data.pharmacy.name) : (B.pharmacies[pId] ? B.pharmacies[pId].name : 'Pharmacy');

  const allOrders = await getDeliveryOrders();
  const pharmOrders = allOrders.filter(o => o.pharmacy_id === pId);

  $('#rs').innerHTML = `
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
      <h3 style="margin:0; font-size:1.1rem; color:var(--ink);">📋 Inventory Shelf Stock & Reorder Requirements</h3>
      <span class="pill" style="background:var(--panel); border:1px solid var(--line); color:var(--mut);">Cloud POS Sync Active</span>
    </div>

    <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--line); text-align:left; color:var(--mut);">
          <th style="padding:8px;">Medicine</th>
          <th style="padding:8px;">Shelf Stock</th>
          <th style="padding:8px;">Days Cover</th>
          <th style="padding:8px;">Risk (P.Out)</th>
          <th style="padding:8px;">Suggested Reorder</th>
          <th style="padding:8px;">Action / Restock Order</th>
          <th style="padding:8px;">Audit</th>
        </tr>
      </thead>
      <tbody>
        ${data.rows.map(r => `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:10px 8px;"><b>${r.brand}</b> ${r.is_emergency ? '<span class="badge-24x7">🚨</span>' : ''}</td>
            <td style="padding:10px 8px;"><b>${r.stock}</b></td>
            <td style="padding:10px 8px;">${r.cover}d</td>
            <td style="padding:10px 8px;"><b style="color:${r.p_out > 0.4 ? 'var(--bad)' : r.p_out > 0.2 ? 'var(--warn)' : 'var(--ok)'}">${Math.round(r.p_out * 100)}%</b></td>
            <td style="padding:10px 8px;">${r.suggested > 0 ? `<b style="color:var(--warn);">${r.suggested} units</b>` : '—'}</td>
            <td style="padding:10px 8px;">
              <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
                <span class="pill" style="font-size:0.7rem; background:${r.pri === 0 ? 'var(--bad)' : r.pri === 1 ? 'var(--warn)' : 'var(--ok)'}">${r.action}</span>
                ${(r.suggested > 0 || r.pri <= 1) ? `
                  <button type="button" class="btn-action btn-delivery" style="padding:3px 8px; font-size:0.72rem;" onclick="placeRestockPodOrder(${pId}, ${r.med_id}, ${r.suggested || 25})">
                    📦 Order Restock (Pay on Delivery)
                  </button>
                ` : ''}
              </div>
            </td>
            <td style="padding:10px 8px;">
              <button class="btn-action btn-verify" style="padding:4px 8px; font-size:0.74rem;" onclick="openStockVerificationModal(${pId}, ${r.med_id})">
                Audit
              </button>
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>

    <!-- INCOMING PHARMACEUTICAL PAY ON DELIVERY ORDERS FOR THIS PHARMACY -->
    <div style="margin-top:32px; padding-top:20px; border-top:1px solid var(--line);">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:14px;">
        <div>
          <h3 style="margin:0 0 2px; font-size:1.15rem; color:var(--ink);">🛵 Incoming Pharmaceutical Orders (${pharmName})</h3>
          <p style="margin:0; font-size:0.8rem; color:var(--mut);">Customer Pay on Delivery orders assigned to this pharmacy for packing & doorstep settlement.</p>
        </div>
        <span class="pill" style="background:${pharmOrders.length ? 'var(--ok)' : 'var(--panel)'}; font-weight:700;">
          ${pharmOrders.length} Active Orders
        </span>
      </div>

      ${!pharmOrders.length ? `
        <div style="background:var(--card); border:1px dashed var(--line); border-radius:12px; padding:24px; text-align:center; color:var(--mut); font-size:0.86rem;">
          No active Pay on Delivery orders currently pending for this pharmacy.
        </div>
      ` : `
        <div style="display:flex; flex-direction:column; gap:12px;">
          ${pharmOrders.map(o => {
            const isPaid = o.payment_status && o.payment_status.toLowerCase().includes('paid');
            return `
              <div class="card" style="margin:0; border-left:5px solid ${isPaid ? 'var(--ok)' : 'var(--warn)'}; padding:14px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:8px;">
                  <div>
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                      <b style="font-size:1.05rem; color:var(--ink);">${o.med_brand} (${o.med_strength}) × ${o.quantity}</b>
                      <span class="pill" style="font-size:0.72rem; background:${isPaid ? 'var(--ok)' : 'var(--cob)'};">${o.order_status}</span>
                      <span class="pill" style="font-size:0.72rem; background:rgba(234,179,8,0.15); color:#fbbf24;">${o.payment_method}</span>
                    </div>
                    <div style="font-size:0.8rem; color:var(--mut); margin-top:3px;">
                      Order: <b style="font-family:monospace; color:var(--cob);">${o.id}</b> · Customer: <b>${o.customer_name}</b> (${o.phone}) · Address: <span>${o.address}</span>
                    </div>
                  </div>
                  <div style="text-align:right;">
                    <div style="font-size:1.2rem; font-weight:800; color:var(--ok);">₹${o.total}</div>
                    <div style="font-size:0.72rem; color:var(--mut);">OTP: <b style="color:var(--ok); font-family:monospace;">${o.delivery_otp}</b></div>
                  </div>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-top:10px; padding-top:10px; border-top:1px dashed var(--line);">
                  <div style="font-size:0.8rem;">
                    Pay on Delivery Status: <b style="color:${isPaid ? 'var(--ok)' : '#fbbf24'};">${o.payment_status || 'Pending (Collect on Delivery)'}</b>
                  </div>
                  <div style="display:flex; gap:6px; flex-wrap:wrap;">
                    ${!isPaid ? `
                      <button type="button" class="btn-action" style="padding:4px 10px; font-size:0.75rem; background:linear-gradient(135deg, #10b981 0%, #059669 100%); color:#fff; border:0;" onclick="settleOrderPayment('${o.id}', '${o.payment_method || 'Cash on Delivery'}')">
                        ✅ Settle Pay on Delivery (₹${o.total})
                      </button>
                    ` : ''}
                    <button type="button" class="btn-action" style="padding:4px 10px; font-size:0.75rem;" onclick="advanceOrderStatus('${o.id}')">
                      🚚 Advance Dispatch
                    </button>
                    <button type="button" class="btn-action" style="padding:4px 10px; font-size:0.75rem;" onclick="openInvoiceModal('${o.id}')">
                      🧾 Tax Invoice
                    </button>
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      `}
    </div>
  `;
}

// AI MODEL EVALUATION REPORT & RETRAINING
async function report() {
  let r = await api('/api/report');
  let chartData = await api('/api/chart_stats');
  if (!r) r = localReport();
  if (!chartData) chartData = localChartStats();
  const ms = Object.entries(r.models);
  $('#rp').innerHTML = `
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:18px;">
      <div>
        <h1 style="margin:0 0 4px;">📊 AI Model Performance & Honest Evaluation</h1>
        <p class="lede" style="margin:0;">Tested on future out-of-sample days with 7-day temporal split gaps to prevent data leakage.</p>
      </div>
      <button type="button" class="btn-action btn-simulate-restock" id="btn-retrain" onclick="triggerRetrainModel()" style="font-size:0.9rem; padding:9px 18px; border-radius:10px;">
        ⚡ Retrain Model Live
      </button>
    </div>

    <table>
      <thead>
        <tr>
          <th>Model Strategy</th>
          <th>PR-AUC</th>
          <th>ROC-AUC</th>
          <th>Relative Performance</th>
        </tr>
      </thead>
      <tbody>
        ${ms.map(([n, v]) => `
          <tr>
            <td><b>${n}</b></td>
            <td>${v.pr_auc}</td>
            <td>${v.roc_auc}</td>
            <td style="width:35%">
              <div style="height:10px; border-radius:5px; background:linear-gradient(90deg, var(--cob) 0%, #2563eb 100%); width:${v.pr_auc * 100}%"></div>
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>

    <div class="banner" style="margin-top:24px;">
      <div style="font-size:1.1rem; font-weight:700; color:var(--ink);">Impact Summary: Wasted Trip Reduction</div>
      <div style="margin-top:6px; color:var(--mut); line-height:1.6;">
        • Traditional Nearest-First Search Wasted Trip Rate: <b style="color:var(--bad);">${r.trips.nearest_pct}%</b><br>
        • MedRadar AI Ranked Search Wasted Trip Rate: <b style="color:var(--ok);">${r.trips.model_pct}%</b><br>
        • Calibrated Brier Score: <b>${r.brier}</b> (Lower is better, strictly proper scoring rule)
      </div>
    </div>

    <!-- Trip Outcome Pie / Donut Charts -->
    <div class="grid" style="margin-top:24px; grid-template-columns: 1fr 1fr;">
      <div class="control-panel">
        <h3 style="margin-top:0; color:#34d399; display:flex; align-items:center; gap:8px;">
          <span>🥧 MedRadar AI Search Outcome</span>
        </h3>
        <p style="color:var(--mut); font-size:0.8rem; margin-bottom:14px;">Journey success vs wasted trips when using MedRadar stock probability ranking.</p>
        <div id="pie-ai-trip-wrap" style="display:flex; justify-content:center; align-items:center; min-height:190px;"></div>
      </div>
      <div class="control-panel">
        <h3 style="margin-top:0; color:#60a5fa; display:flex; align-items:center; gap:8px;">
          <span>🥧 Traditional Nearest Search Outcome</span>
        </h3>
        <p style="color:var(--mut); font-size:0.8rem; margin-bottom:14px;">Blind nearest pharmacy visit outcome without stock availability intelligence.</p>
        <div id="pie-near-trip-wrap" style="display:flex; justify-content:center; align-items:center; min-height:190px;"></div>
      </div>
    </div>
  `;

  if (chartData) {
    if (chartData.ai_trip_pie && $('#pie-ai-trip-wrap')) {
      $('#pie-ai-trip-wrap').innerHTML = createSvgPieChart(chartData.ai_trip_pie, {
        size: 180,
        donut: true,
        centerLabel: `${chartData.ai_trip_pie[0].pct}%`,
        centerSub: 'Success'
      });
    }
    if (chartData.near_trip_pie && $('#pie-near-trip-wrap')) {
      $('#pie-near-trip-wrap').innerHTML = createSvgPieChart(chartData.near_trip_pie, {
        size: 180,
        donut: true,
        centerLabel: `${chartData.near_trip_pie[0].pct}%`,
        centerSub: 'Success'
      });
    }
  }
}

async function triggerRetrainModel() {
  const btn = $('#btn-retrain');
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = '⏳ Retraining Model...';
  }
  showToast("Model Retraining Initiated", "Running train.py with temporal splits and out-of-sample cross-validation...", "info", 5000);
  try {
    const res = await api('/api/retrain', { method: 'POST' });
    if (res && res.status === 'success') {
      showToast("Training Complete", "Model retrained! New ROC-AUC & calibrated weights active.", "success", 5000);
      await report();
      if (document.querySelector('button[data-v="forecast"]').getAttribute('aria-selected') === 'true') {
        renderForecastPage();
      }
    } else {
      showToast("Training Failed", (res && res.message) || "Retraining failed", "emergency");
    }
  } catch (err) {
    showToast("Error", err.message, "emergency");
  } finally {
    if (btn) {
      btn.disabled = false;
      btn.innerHTML = '⚡ Retrain Model Live';
    }
  }
}

// MEDICINE KIT
function addToKit(pharmId, medId) {
  const med = B.medicines.find(m => m.id === medId);
  const pharm = B.pharmacies.find(p => p.id === pharmId);
  if (!med) return;
  medicineKit.push({ pharmId, medId, brand: med.brand, strength: med.strength, price: med.price, pharmName: pharm ? pharm.name : '' });
  updateKitBar();
  showToast("Added to Kit", `${med.brand} added to medicine kit!`, "success", 2500);
}

function updateKitBar() {
  const bar = $('#kit-bar');
  if (!bar) return;
  const count = medicineKit.length;
  $('#kit-count').textContent = count;
  const total = medicineKit.reduce((s, x) => s + x.price, 0);
  $('#kit-total').textContent = total;
  if (count > 0) bar.classList.add('active');
  else bar.classList.remove('active');
}

function clearMedicineKit() {
  medicineKit = [];
  updateKitBar();
}

function openKitCheckout() {
  if (!medicineKit.length) return;
  openDeliveryModal(medicineKit[0].pharmId, medicineKit[0].medId);
}

// PWA INSTALLATION & SERVICE WORKER
let deferredInstallPrompt = null;

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js').catch(e => console.warn('PWA SW registration:', e));
  });
}

window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredInstallPrompt = e;
  const btn = $('#btn-pwa-install');
  if (btn) btn.style.display = 'inline-flex';
  const banner = $('#pwa-install-banner');
  if (banner && !sessionStorage.getItem('pwa_banner_dismissed')) {
    banner.style.display = 'flex';
  }
});

window.addEventListener('appinstalled', () => {
  deferredInstallPrompt = null;
  const btn = $('#btn-pwa-install');
  if (btn) btn.style.display = 'none';
  const banner = $('#pwa-install-banner');
  if (banner) banner.style.display = 'none';
  showToast("App Installed", "MedRadar installed successfully!", "success", 4000);
});

async function triggerPwaInstall() {
  if (deferredInstallPrompt) {
    deferredInstallPrompt.prompt();
    const { outcome } = await deferredInstallPrompt.userChoice;
    if (outcome === 'accepted') {
      showToast("Installing", "Installing MedRadar...", "info", 2500);
    }
    deferredInstallPrompt = null;
    const banner = $('#pwa-install-banner');
    if (banner) banner.style.display = 'none';
  } else {
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    if (isIOS) {
      alert("To install MedRadar on iPhone / iPad:\n\n1. Tap the Share button (⎋) at the bottom.\n2. Tap 'Add to Home Screen' (➕).\n3. Tap 'Add' to install.");
    } else {
      alert("To install MedRadar App:\n\n• On Android Phone: Tap the browser menu (⋮) -> 'Add to Home Screen' or 'Install App'.\n• On Laptop (Chrome / Edge): Click the Install icon (⊕) in the browser address bar.");
    }
  }
}

function dismissPwaBanner() {
  const banner = $('#pwa-install-banner');
  if (banner) banner.style.display = 'none';
  sessionStorage.setItem('pwa_banner_dismissed', '1');
}

init();
</script>
</body>
</html>
