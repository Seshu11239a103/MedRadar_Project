        </table>

        <div style="display:flex; justify-content:space-between; margin-top:12px; padding-top:10px; border-top:1px solid #e2e8f0; font-size:0.85rem; flex-wrap:wrap; gap:10px;">
          <div style="font-size:0.75rem; color:#64748b; max-width:55%;">
