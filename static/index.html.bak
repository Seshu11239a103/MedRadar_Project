function localReport() {
  return {
    base_rate: 16.23,
    models: {
      "Rule: out today = out tomorrow": { pr_auc: 0.548, roc_auc: 0.825 },
      "Rule: fewer days of cover = higher risk": { pr_auc: 0.688, roc_auc: 0.950 },
      "Logistic regression (basic inputs)": { pr_auc: 0.702, roc_auc: 0.951 },
      "MedRadar model (calibrated)": { pr_auc: 0.819, roc_auc: 0.964 }
    },
    trips: { nearest_pct: 15.5, model_pct: 3.3, n: 3000 },
    brier: 0.0412
  };
}

function localRestockDesk(pharmId) {
  const p = B.pharmacies.find(x => x.id === parseInt(pharmId)) || B.pharmacies[0];
  const rows = B.medicines.map((m, i) => {
    const st = ((p.id * 13 + m.id * 17) % 24);
    const dem = Math.max(0.5, ((m.id * 5) % 15) / 10 + 0.8);
    const cover = Math.round((st / dem) * 10) / 10;
    const p_out = Math.min(0.95, Math.max(0.05, Math.round((0.8 - (cover / 15)) * 100) / 100));
    const pri = p_out > 0.4 ? 0 : p_out > 0.2 ? 1 : 2;
    const act = pri === 0 ? "URGENT ORDER" : pri === 1 ? "Reorder Soon" : "Healthy";
    const suggested = pri === 0 ? Math.round(dem * 14) : pri === 1 ? Math.round(dem * 7) : 0;
    return {
      med_id: m.id,
      brand: m.brand,
      is_emergency: m.is_emergency,
      stock: st,
      cover: cover,
      p_out: p_out,
      pri: pri,
      action: act,
      suggested: suggested
    };
  });
  return { pharmacy: p, rows: rows };
}

// =========================================================================
// FEATURE 2: MEDICINE SHORTAGE FORECASTING
// =========================================================================
async function renderForecastPage() {
  let sumData = await api('/api/forecast_summary');
  let chartData = await api('/api/chart_stats');
  if (!sumData || !sumData.summary) sumData = localForecastSummary();
  if (!chartData) chartData = localChartStats();

  if (sumData && sumData.summary) {
    const s = sumData.summary;
    $('#forecast-kpi-grid').innerHTML = `
      <div class="kpi-card" style="border-left:5px solid var(--bad);">
        <span style="color:var(--mut); font-size:0.8rem; font-weight:700;">CRITICAL DEPLETION (&lt;48H)</span>
        <b style="color:var(--bad);">${s.critical_count} Medicines</b>
        <span style="font-size:0.75rem; color:var(--mut);">Imminent stockout across district</span>
      </div>
      <div class="kpi-card" style="border-left:5px solid var(--warn);">
        <span style="color:var(--mut); font-size:0.8rem; font-weight:700;">HIGH SHORTAGE RISK (3-7D)</span>
        <b style="color:var(--warn);">${s.high_risk_count} Medicines</b>
        <span style="font-size:0.75rem; color:var(--mut);">Pending orders delayed</span>
      </div>
      <div class="kpi-card" style="border-left:5px solid var(--cob);">
        <span style="color:var(--mut); font-size:0.8rem; font-weight:700;">NETWORK AVERAGE COVER</span>
        <b style="color:var(--cob);">${s.average_network_cover_days} Days</b>
        <span style="font-size:0.75rem; color:var(--mut);">Daily demand vs regional buffer</span>
      </div>
      <div class="kpi-card" style="border-left:5px solid #a855f7;">
        <span style="color:var(--mut); font-size:0.8rem; font-weight:700;">SUPPLY CHAIN STRESS</span>
        <b style="color:#c084fc;">${s.supply_stress_index} / 100</b>
        <span style="font-size:0.75rem; color:var(--mut);">Systemic distributor strain</span>
      </div>
    `;
  }

  // Populate medicine dropdown
  $('#forecast-med-select').innerHTML = B.medicines.map(m =>
    `<option value="${m.id}" ${m.id === currentForecastMed ? 'selected' : ''}>${m.brand} (${m.salt} ${m.strength})</option>`
  ).join('');

  // Render Regional Shortage Risk & Category Contribution Pie Charts
  if (chartData) {
    if (chartData.shortage_risk_pie && $('#pie-risk-chart-wrap')) {
      $('#pie-risk-chart-wrap').innerHTML = createSvgPieChart(chartData.shortage_risk_pie, {
        size: 200,
        donut: true,
        centerLabel: `${chartData.total_medicines || 40}`,
        centerSub: 'Medicines'
      });
    }
    if (chartData.category_shortage_pie && $('#pie-category-chart-wrap')) {
      $('#pie-category-chart-wrap').innerHTML = createSvgPieChart(chartData.category_shortage_pie, {
        size: 200,
        donut: true,
        centerLabel: 'Depleted',
        centerSub: 'by Category'
      });
    }
  }

  await loadMedicineForecast(currentForecastMed);
}

let currentForecastData = null;

async function loadMedicineForecast(medId) {
  currentForecastMed = parseInt(medId);
  let data = await api(`/api/shortage_forecast?med_id=${currentForecastMed}`);
  if (!data) data = localMedicineForecast(currentForecastMed);
  currentForecastData = data;

  $('#forecast-chart-title').textContent = `${data.medicine.brand}: 30-Day Projected Stock Depletion Curve`;
  const riskPill = $('#forecast-risk-pill');
  riskPill.textContent = data.risk_level;
  riskPill.style.background = data.risk_level === 'CRITICAL' ? 'var(--bad)' : data.risk_level === 'HIGH RISK' ? 'var(--warn)' : 'var(--ok)';

  renderForecastChart(data.trajectory, data.total_regional_stock);

  // Root Causes
  $('#forecast-root-causes').innerHTML = data.root_causes.map(rc => `
    <div style="background:var(--card); border:1px solid var(--line); border-radius:10px; padding:10px 14px; margin-bottom:8px; font-size:0.82rem; display:flex; align-items:center; gap:8px;">
      <span style="color:var(--warn); font-size:1.1rem;">⚠️</span>
      <span>${rc}</span>
    </div>
  `).join('');

  // Pharmacy depletion countdown table
  $('#forecast-pharm-table').innerHTML = `
    <table style="width:100%; border-collapse:collapse; font-size:0.8rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--line); text-align:left; color:var(--mut);">
          <th style="padding:6px;">Pharmacy</th>
          <th style="padding:6px;">Stock</th>
          <th style="padding:6px;">Daily Burn</th>
          <th style="padding:6px;">Cover</th>
          <th style="padding:6px;">Status</th>
        </tr>
      </thead>
      <tbody>
        ${data.pharmacy_breakdown.map(p => `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.04);">
            <td style="padding:8px 6px;"><b>${p.name}</b><div style="font-size:0.72rem; color:var(--mut);">${p.area}</div></td>
            <td style="padding:8px 6px;">${p.stock}</td>
            <td style="padding:8px 6px;">${p.daily_demand}/d</td>
            <td style="padding:8px 6px;"><b>${p.cover_days}d</b></td>
            <td style="padding:8px 6px;"><span class="pill" style="font-size:0.68rem; background:${p.stock === 0 ? 'var(--bad)' : p.cover_days < 3 ? 'var(--warn)' : 'var(--ok)'}">${p.status}</span></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
}

function renderForecastChart(trajectory, maxStock) {
  const W = 620, H = 240, pad = 40;
  const maxVal = Math.max(maxStock * 1.15, 50);
  const pts = trajectory.map(t => {
    const x = pad + (t.day / 30) * (W - 2 * pad);
    const y = H - pad - (t.projected_stock / maxVal) * (H - 2 * pad);
    return { x, y, ...t };
  });

  const polyPts = `${pad},${H - pad} ` + pts.map(p => `${p.x},${p.y}`).join(' ') + ` ${W - pad},${H - pad}`;

  let svg = `
    <svg viewBox="0 0 ${W} ${H}" style="width:100%; height:auto; display:block;">
      <!-- Grid lines -->
      <line x1="${pad}" y1="${pad}" x2="${pad}" y2="${H - pad}" stroke="var(--line)" stroke-width="1"/>
      <line x1="${pad}" y1="${H - pad}" x2="${W - pad}" y2="${H - pad}" stroke="var(--line)" stroke-width="1"/>

      <!-- Safe stock threshold line (25%) -->
      <line x1="${pad}" y1="${H - pad - (0.25 * maxStock / maxVal) * (H - 2 * pad)}" x2="${W - pad}" y2="${H - pad - (0.25 * maxStock / maxVal) * (H - 2 * pad)}" stroke="var(--warn)" stroke-dasharray="4 4" stroke-width="1.5" opacity="0.7"/>
      <text x="${W - pad - 120}" y="${H - pad - (0.25 * maxStock / maxVal) * (H - 2 * pad) - 4}" font-size="10" fill="var(--warn)">Critical Buffer Threshold</text>

      <!-- Area fill -->
      <polygon points="${polyPts}" fill="rgba(59, 130, 246, 0.15)"/>

      <!-- Trajectory curve -->
      <polyline points="${pts.map(p => `${p.x},${p.y}`).join(' ')}" fill="none" stroke="#3b82f6" stroke-width="3" stroke-linecap="round"/>

      <!-- Dots & Values -->
      ${pts.map(p => `
        <circle cx="${p.x}" cy="${p.y}" r="4" fill="${p.projected_stock === 0 ? 'var(--bad)' : 'var(--cob)'}" stroke="#fff" stroke-width="1.5"/>
        <text x="${p.x}" y="${H - pad + 18}" font-size="10" text-anchor="middle" fill="var(--mut)">${p.label}</text>
        <text x="${p.x}" y="${p.y - 8}" font-size="10" font-weight="700" text-anchor="middle" fill="${p.projected_stock === 0 ? 'var(--bad)' : 'var(--ink)'}">${p.projected_stock}</text>
      `).join('')}
    </svg>
  `;
  $('#forecast-chart-svg-wrap').innerHTML = svg;
}

function updateForecastSimulator() {
  if (!currentForecastData) return;
  const demandSurge = parseInt($('#sim-demand-slider').value);
  const delayDays = parseInt($('#sim-delay-slider').value);
  $('#sim-demand-val').textContent = `+${demandSurge}%`;
  $('#sim-delay-val').textContent = `+${delayDays} Days`;

  const totalStock = currentForecastData.total_regional_stock;
  const baseDem = currentForecastData.total_daily_demand;
  const adjDem = baseDem * (1 + demandSurge / 100);
  const restockDay = currentForecastData.restock_expected_in_days + delayDays;
  const incoming = currentForecastData.pending_incoming_units;

  const simTrajectory = [0, 1, 2, 3, 5, 7, 10, 14, 21, 30].map(d => {
    const burn = d * adjDem;
    const inc = d >= restockDay ? incoming : 0;
    const stock = Math.max(0, Math.round(totalStock - burn + inc));
    return {
      day: d,
      label: d === 0 ? "Today" : `+${d}d`,
      projected_stock: stock,
      is_depleted: stock === 0
    };
  });

  renderForecastChart(simTrajectory, totalStock);

  const depletionDay = simTrajectory.find(t => t.projected_stock === 0);
  if (depletionDay) {
    $('#sim-impact-msg').innerHTML = `<span style="color:var(--bad);">⚠️ Stress Test Result: Regional stockout accelerated to <b>${depletionDay.label}</b>! Immediate distributor diversion needed.</span>`;
  } else {
    $('#sim-impact-msg').innerHTML = `<span style="color:var(--ok);">✅ Stress Test Result: Stock buffer sustains regional demand across 30 days.</span>`;
  }
}

